  "tasks": [
    {
      "id": "de.task.introduction.greet",
      "language": "de",
      "domain": "introductions",
      "cefrApproximation": "A1",
      "goal": "Open a brief exchange with an appropriate greeting.",
      "context": "You meet an adult for the first time in a neutral everyday setting.",
      "learnerRole": "New acquaintance",
      "npcRole": "New acquaintance",
      "requiredFunctionIds": ["de.function.greeting-basic"],
      "eligibleConceptIds": ["de.function.greeting-basic", "de.pronoun.sie-formal"],
      "initialStateId": "de.state.greet.waiting",
      "successStateIds": ["de.state.greet.complete"],
      "states": [
        { "id": "de.state.greet.waiting", "allowedIntents": ["greet"], "scriptedFallback": ["Guten Tag!"] },
        { "id": "de.state.greet.complete", "allowedIntents": ["continue", "exit"], "scriptedFallback": ["Guten Tag! Freut mich."] }
      ],
      "transitions": [{ "fromStateId": "de.state.greet.waiting", "toStateId": "de.state.greet.complete", "evaluatorId": "de.eval.greeting-token" }],
      "evaluators": [
        { "id": "de.eval.greeting-token", "kind": "anyAllowedToken", "expectedValues": ["hallo", "guten tag"] },
        { "id": "de.eval.greeting-complete", "kind": "stateReached", "expectedValues": ["de.state.greet.complete"] }
      ],
      "successConditions": [{ "evaluatorId": "de.eval.greeting-complete", "description": "The greeting state is reached after an allowed greeting." }],
      "sourceIds": ["source.de.dib-2017", "source.de.cefr-2020"],
      "review": { "status": "machineValidated", "reviewer": null, "reviewedOn": null, "notes": "Scenario wording and register need competent review." }
    },
