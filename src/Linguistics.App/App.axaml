<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Linguistics.App.Controls"
             x:Class="Linguistics.App.App"
             Name="Linguistics"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppCanvasBrush" Color="#F4F2EA" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFEFA" />
                    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#EEECE3" />
                    <SolidColorBrush x:Key="AppSurfaceStrongBrush" Color="#E1E6DF" />
                    <SolidColorBrush x:Key="AppPaperBrush" Color="#FFFDF6" />
                    <SolidColorBrush x:Key="AppPaperAltBrush" Color="#F4F1E8" />
                    <SolidColorBrush x:Key="AppPaperEdgeBrush" Color="#C8D3CB" />
                    <SolidColorBrush x:Key="AppCutoutMarginBrush" Color="#FFFEFA" />
                    <SolidColorBrush x:Key="AppCutoutEdgeBrush" Color="#D8D2C5" />
                    <SolidColorBrush x:Key="AppCutoutInkBrush" Color="#19312A" />
                    <SolidColorBrush x:Key="AppTapeBrush" Color="#E1C77B" />
                    <SolidColorBrush x:Key="AppTapeEdgeBrush" Color="#765A20" />
                    <SolidColorBrush x:Key="AppStampBrush" Color="#F6EDE4" />
                    <SolidColorBrush x:Key="AppStampInkBrush" Color="#873A34" />
                    <SolidColorBrush x:Key="AppTornEdgeBrush" Color="#DDE7DE" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#19312A" />
                    <SolidColorBrush x:Key="AppTextMutedBrush" Color="#617169" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#D4DCD6" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#1D745C" />
                    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#155D49" />
                    <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#104B3B" />
                    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#D8EEE5" />
                    <SolidColorBrush x:Key="AppAccentTextBrush" Color="#125341" />
                    <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FFFDF8" />
                    <SolidColorBrush x:Key="AppAmberBrush" Color="#E5A13F" />
                    <SolidColorBrush x:Key="AppAmberSoftBrush" Color="#F9E9C7" />
                    <SolidColorBrush x:Key="AppBlueSoftBrush" Color="#DDEBF3" />
                    <SolidColorBrush x:Key="AppDangerBrush" Color="#B34A3A" />
                    <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#F8E2DE" />
                    <SolidColorBrush x:Key="AppFocusBrush" Color="#9A5C00" />
                    <SolidColorBrush x:Key="AppNavBrush" Color="#102A24" />
                    <SolidColorBrush x:Key="AppNavSurfaceBrush" Color="#173831" />
                    <SolidColorBrush x:Key="AppNavHoverBrush" Color="#20453C" />
                    <SolidColorBrush x:Key="AppNavTextBrush" Color="#EEF7F3" />
                    <SolidColorBrush x:Key="AppNavMutedBrush" Color="#B7CBC3" />
                    <SolidColorBrush x:Key="AppNavAccentBrush" Color="#75D8B4" />
                    <BoxShadows x:Key="AppPaperShadow">0 14 30 0 #2B355448, 0 2 6 0 #18355448</BoxShadows>
                    <BoxShadows x:Key="AppCutoutShadow">0 9 18 0 #30334D43, 0 2 4 0 #1F334D43</BoxShadows>
                    <BoxShadows x:Key="AppStampShadow">0 7 14 0 #263C5147, 0 2 3 0 #1C3C5147</BoxShadows>
                    <DrawingBrush x:Key="AppPaperGrainBrush"
                                  SourceRect="0,0,96,96"
                                  DestinationRect="0,0,96,96"
                                  Stretch="None"
                                  TileMode="Tile"
                                  Opacity="0.1">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#71827A"
                                             Geometry="M 7,12 L 10,12 10,12.35 7,12.35 Z M 43,8 L 44,8 44,8.5 43,8.5 Z M 82,17 L 85,17 85,17.35 82,17.35 Z M 24,29 L 25,29 25,29.5 24,29.5 Z M 61,35 L 64,35 64,35.35 61,35.35 Z M 91,41 L 92,41 92,41.5 91,41.5 Z M 13,52 L 16,52 16,52.35 13,52.35 Z M 48,58 L 49,58 49,58.5 48,58.5 Z M 75,64 L 78,64 78,64.35 75,64.35 Z M 31,72 L 32,72 32,72.5 31,72.5 Z M 4,84 L 7,84 7,84.35 4,84.35 Z M 55,89 L 58,89 58,89.35 55,89.35 Z M 88,79 L 89,79 89,79.5 88,79.5 Z" />
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                    <LinearGradientBrush x:Key="AppHeroBrush"
                                         StartPoint="0%,0%"
                                         EndPoint="100%,100%">
                        <GradientStop Color="#DEF1E8" Offset="0" />
                        <GradientStop Color="#F8E9CB" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AppGlowBrush"
                                         StartPoint="0%,0%"
                                         EndPoint="100%,100%">
                        <GradientStop Color="#4FD2A7" Offset="0" />
                        <GradientStop Color="#F0A84A" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppCanvasBrush" Color="#0C1714" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#14241F" />
                    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#1B3029" />
                    <SolidColorBrush x:Key="AppSurfaceStrongBrush" Color="#254038" />
                    <SolidColorBrush x:Key="AppPaperBrush" Color="#152720" />
                    <SolidColorBrush x:Key="AppPaperAltBrush" Color="#1D342C" />
                    <SolidColorBrush x:Key="AppPaperEdgeBrush" Color="#3A5A50" />
                    <SolidColorBrush x:Key="AppCutoutMarginBrush" Color="#E8E3D8" />
                    <SolidColorBrush x:Key="AppCutoutEdgeBrush" Color="#C7C0B3" />
                    <SolidColorBrush x:Key="AppCutoutInkBrush" Color="#19312A" />
                    <SolidColorBrush x:Key="AppTapeBrush" Color="#C6A863" />
                    <SolidColorBrush x:Key="AppTapeEdgeBrush" Color="#594117" />
                    <SolidColorBrush x:Key="AppStampBrush" Color="#1D342C" />
                    <SolidColorBrush x:Key="AppStampInkBrush" Color="#F3B19B" />
                    <SolidColorBrush x:Key="AppTornEdgeBrush" Color="#29453B" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#F0F6F2" />
                    <SolidColorBrush x:Key="AppTextMutedBrush" Color="#B4C4BD" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#315047" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#72D5B2" />
                    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#8BE1C2" />
                    <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#59BC99" />
                    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#173E32" />
                    <SolidColorBrush x:Key="AppAccentTextBrush" Color="#8CE2C2" />
                    <SolidColorBrush x:Key="AppOnAccentBrush" Color="#071B14" />
                    <SolidColorBrush x:Key="AppAmberBrush" Color="#F1B85D" />
                    <SolidColorBrush x:Key="AppAmberSoftBrush" Color="#49371B" />
                    <SolidColorBrush x:Key="AppBlueSoftBrush" Color="#213B4B" />
                    <SolidColorBrush x:Key="AppDangerBrush" Color="#F28A78" />
                    <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#4B2925" />
                    <SolidColorBrush x:Key="AppFocusBrush" Color="#F1B85D" />
                    <SolidColorBrush x:Key="AppNavBrush" Color="#08110E" />
                    <SolidColorBrush x:Key="AppNavSurfaceBrush" Color="#132C25" />
                    <SolidColorBrush x:Key="AppNavHoverBrush" Color="#1B3C33" />
                    <SolidColorBrush x:Key="AppNavTextBrush" Color="#EFF8F4" />
                    <SolidColorBrush x:Key="AppNavMutedBrush" Color="#A8BEB5" />
                    <SolidColorBrush x:Key="AppNavAccentBrush" Color="#72D5B2" />
                    <BoxShadows x:Key="AppPaperShadow">0 18 40 0 #8A071B14, 0 3 8 0 #68071B14</BoxShadows>
                    <BoxShadows x:Key="AppCutoutShadow">0 10 20 0 #7305100D, 0 2 5 0 #5905100D</BoxShadows>
                    <BoxShadows x:Key="AppStampShadow">0 8 16 0 #780B1C16, 0 2 4 0 #600B1C16</BoxShadows>
                    <DrawingBrush x:Key="AppPaperGrainBrush"
                                  SourceRect="0,0,96,96"
                                  DestinationRect="0,0,96,96"
                                  Stretch="None"
                                  TileMode="Tile"
                                  Opacity="0.12">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#6E847A"
                                             Geometry="M 7,12 L 10,12 10,12.35 7,12.35 Z M 43,8 L 44,8 44,8.5 43,8.5 Z M 82,17 L 85,17 85,17.35 82,17.35 Z M 24,29 L 25,29 25,29.5 24,29.5 Z M 61,35 L 64,35 64,35.35 61,35.35 Z M 91,41 L 92,41 92,41.5 91,41.5 Z M 13,52 L 16,52 16,52.35 13,52.35 Z M 48,58 L 49,58 49,58.5 48,58.5 Z M 75,64 L 78,64 78,64.35 75,64.35 Z M 31,72 L 32,72 32,72.5 31,72.5 Z M 4,84 L 7,84 7,84.35 4,84.35 Z M 55,89 L 58,89 58,89.35 55,89.35 Z M 88,79 L 89,79 89,79.5 88,79.5 Z" />
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                    <LinearGradientBrush x:Key="AppHeroBrush"
                                         StartPoint="0%,0%"
                                         EndPoint="100%,100%">
                        <GradientStop Color="#173A30" Offset="0" />
                        <GradientStop Color="#3B301E" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AppGlowBrush"
                                         StartPoint="0%,0%"
                                         EndPoint="100%,100%">
                        <GradientStop Color="#67D6B0" Offset="0" />
                        <GradientStop Color="#EAB15A" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#1D745C" />
                <ColorPaletteResources x:Key="Dark" Accent="#72D5B2" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppCanvasBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style Selector="UserControl">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style Selector="TextBlock.display">
            <Setter Property="FontSize" Value="40" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="47" />
            <Setter Property="LetterSpacing" Value="-0.4" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.4" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentTextBrush}" />
        </Style>
        <Style Selector="TextBlock.lede">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="LineHeight" Value="25" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="29" />
        </Style>
        <Style Selector="TextBlock.on-accent">
            <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
        </Style>
        <Style Selector="TextBlock.lesson-label">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentTextBrush}" />
        </Style>

        <Style Selector="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="17,9" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RenderTransform" Value="translateY(0px)" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceStrongBrush}" />
        </Style>
        <Style Selector="Button:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AppFocusBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentHoverBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="{DynamicResource AppAccentPressedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentPressedBrush}" />
        </Style>
        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.lesson-tile">
            <Setter Property="MinHeight" Value="102" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.lesson-tile:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource AppDangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
        </Style>
        <Style Selector="Window.motion-enabled Button">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Window.motion-enabled Button.lift:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
        </Style>
        <Style Selector="Window.motion-enabled Button.lift:pressed">
            <Setter Property="RenderTransform" Value="translateY(0px)" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceStrongBrush}" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Padding" Value="24" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource AppPaperBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppPaperEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="{DynamicResource AppPaperShadow}" />
            <Setter Property="RenderTransform" Value="translateY(0px)" />
        </Style>
        <Style Selector="Border.soft-card">
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource AppPaperAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppPaperEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.hero-card">
            <Setter Property="Padding" Value="30" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Background" Value="{DynamicResource AppHeroBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="{DynamicResource AppPaperShadow}" />
        </Style>
        <Style Selector="Border.accent-card">
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.paper-thread">
            <Setter Property="Height" Value="3" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="Border.warning-card">
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource AppAmberSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAmberBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.danger-card">
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.status-pill">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        </Style>
        <Style Selector="Border.metric-card">
            <Setter Property="Padding" Value="18" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="controls|PaperCard">
            <Setter Property="Padding" Value="24" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource AppPaperBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppPaperEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1,1,2,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BoxShadow="{DynamicResource AppPaperShadow}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Grid>
                            <Border Background="{DynamicResource AppPaperGrainBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="controls|PaperCard.soft">
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource AppPaperAltBrush}" />
        </Style>
        <Style Selector="controls|PaperCard.settings-sheet">
            <Setter Property="Padding" Value="22" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="controls|PaperCard.danger">
            <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
            <Setter Property="BorderThickness" Value="1,1,2,1" />
        </Style>

        <Style Selector="controls|CutoutFrame">
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource AppCutoutMarginBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCutoutEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BoxShadow="{DynamicResource AppCutoutShadow}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Border Background="{DynamicResource AppPaperGrainBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    IsHitTestVisible="False" />
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="controls|CutoutFrame.tilt-left">
            <Setter Property="RenderTransform" Value="rotate(-1.5deg)" />
        </Style>
        <Style Selector="controls|CutoutFrame.tilt-right">
            <Setter Property="RenderTransform" Value="rotate(1.5deg)" />
        </Style>
        <Style Selector="controls|CutoutFrame TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppCutoutInkBrush}" />
        </Style>

        <Style Selector="controls|PaperTape">
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="MinHeight" Value="62" />
            <Setter Property="Padding" Value="15,13,15,12" />
            <Setter Property="Background" Value="{DynamicResource AppPaperBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppPaperEdgeBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Margin="2,0,2,2">
                        <Border Margin="0,10,0,0"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,2,1"
                                BoxShadow="{DynamicResource AppCutoutShadow}"
                                CornerRadius="3">
                            <Grid>
                                <Border Background="{DynamicResource AppPaperGrainBrush}"
                                        CornerRadius="3"
                                        IsHitTestVisible="False"
                                        Opacity="0.6" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontStyle="{TemplateBinding FontStyle}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{DynamicResource AppTextBrush}"
                                           Text="{TemplateBinding Content}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <Path Width="76"
                              Height="22"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              Data="M 8,0 L 100,2 L 92,32 L 0,30 Z"
                              Fill="{DynamicResource AppTapeBrush}"
                              Stroke="{DynamicResource AppTapeEdgeBrush}"
                              StrokeThickness="1"
                              Stretch="Fill"
                              Opacity="0.68" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="controls|PaperTape.compact">
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="11,8,11,7" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="controls|PaperStamp">
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="76" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="{DynamicResource AppStampBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppStampInkBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppStampInkBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BoxShadow="{DynamicResource AppStampShadow}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Border Background="{DynamicResource AppPaperGrainBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    IsHitTestVisible="False"
                                    Opacity="0.5" />
                            <Border Margin="5"
                                    BorderBrush="{DynamicResource AppStampInkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    IsHitTestVisible="False"
                                    Opacity="0.55" />
                            <TextBlock Margin="{TemplateBinding Padding}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontStyle="{TemplateBinding FontStyle}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{DynamicResource AppStampInkBrush}"
                                       Text="{TemplateBinding Content}"
                                       TextAlignment="Center"
                                       TextWrapping="NoWrap" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="controls|PaperStamp.rectangle">
            <Setter Property="Width" Value="104" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="controls|TornEdge">
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="{DynamicResource AppTornEdgeBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Path Data="M 0,11 L 1.5,5 L 4,8 L 5.5,2 L 9,10 L 12,6 L 14,12 L 18,4 L 21,9 L 25,3 L 29,11 L 32,7 L 36,13 L 39,5 L 43,9 L 47,2 L 51,11 L 54,6 L 58,12 L 62,4 L 65,8 L 69,1 L 73,11 L 77,7 L 80,12 L 84,5 L 87,9 L 91,3 L 94,11 L 97,6 L 100,10 L 100,24 L 0,24 Z"
                          Fill="{TemplateBinding Background}"
                          Stroke="{DynamicResource AppPaperEdgeBrush}"
                          StrokeThickness="0.6"
                          Stretch="Fill" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="controls|TornEdge.bottom">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="Border.lesson-unit-number, Border.lesson-symbol">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="Border.lesson-supporting">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        </Style>
        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
        </Style>
        <Style Selector="Border.weather-window-frame">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCutoutMarginBrush}" />
            <Setter Property="BorderThickness" Value="9" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>
        <Style Selector="Border.weather-window-mullion">
            <Setter Property="Background" Value="{DynamicResource AppCutoutMarginBrush}" />
        </Style>
        <Style Selector="Border.guide-bubble">
            <Setter Property="Background" Value="{DynamicResource AppNavSurfaceBrush}" />
        </Style>
        <Style Selector="Border.learner-bubble">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="Window.motion-enabled Border.conversation-bubble">
            <Style.Animations>
                <Animation Duration="0:0:0.18"
                           FillMode="Forward"
                           Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="ListBox.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.nav > ListBoxItem">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="15,11" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppNavMutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="RenderTransform" Value="translateX(0px)" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.nav > ListBoxItem TextBlock.nav-label">
            <Setter Property="Foreground" Value="{DynamicResource AppNavMutedBrush}" />
        </Style>
        <Style Selector="ListBox.nav > ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppNavHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppNavTextBrush}" />
        </Style>
        <Style Selector="ListBox.nav > ListBoxItem:pointerover TextBlock.nav-label">
            <Setter Property="Foreground" Value="{DynamicResource AppNavTextBrush}" />
        </Style>
        <Style Selector="ListBox.nav > ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AppNavSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppNavAccentBrush}" />
        </Style>
        <Style Selector="ListBox.nav > ListBoxItem:selected TextBlock.nav-label">
            <Setter Property="Foreground" Value="{DynamicResource AppNavAccentBrush}" />
        </Style>
        <Style Selector="ListBox.nav > ListBoxItem:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AppFocusBrush}" />
        </Style>
        <Style Selector="Window.motion-enabled ListBox.nav > ListBoxItem">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.14" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Window.motion-enabled ListBox.nav > ListBoxItem:selected">
            <Setter Property="RenderTransform" Value="translateX(3px)" />
        </Style>
        <Style Selector="ListBox.content-list">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="ListBox.content-list > ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>

        <Style Selector="Expander">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
    </Application.Styles>
</Application>
