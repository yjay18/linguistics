<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Linguistics.App.Controls"
             xmlns:loc="using:Linguistics.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="700"
             x:Class="Linguistics.App.Features.Today.TodayView">
    <StackPanel Spacing="22">
        <controls:PaperCard x:Name="LoadingState"
                            Classes="soft">
            <StackPanel Spacing="12">
                <ProgressBar IsIndeterminate="True"
                             AutomationProperties.Name="{loc:Localize Today_Preparing}" />
                <TextBlock Text="{loc:Localize Today_Loading}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </controls:PaperCard>

        <controls:PaperCard x:Name="PlanCard"
                            IsVisible="False"
                            Padding="28"
                            Background="{DynamicResource AppPaperAltBrush}">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8">
                    <controls:PaperTape Content="{loc:Localize Today_NextMove}"
                                        Classes="compact"
                                        Angle="-1.2"
                                        HorizontalAlignment="Left" />
                    <TextBlock x:Name="HeadlineText"
                               FontSize="30"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               LineHeight="38"
                               AutomationProperties.HeadingLevel="2"
                               AutomationProperties.AutomationId="TodayHeadline" />
                    <TextBlock x:Name="ExplanationText"
                               FontSize="16"
                               TextWrapping="Wrap"
                               Opacity="0.78" />
                </StackPanel>
                <controls:PaperStamp x:Name="ActionGlyph"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Margin="24,0,0,0"
                                     Width="82"
                                     Height="82"
                                     Content="→"
                                     FontSize="31"
                                     Angle="2"
                                     AutomationProperties.Name="{loc:Localize Today_RecommendedAction}" />
                <Button x:Name="PrimaryActionButton"
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="0,24,0,0"
                        Classes="primary lift"
                        HorizontalAlignment="Left"
                        Click="OnPrimaryActionClicked"
                        AutomationProperties.AutomationId="TodayPrimaryAction" />
            </Grid>
        </controls:PaperCard>

        <Grid x:Name="EvidenceGrid"
              IsVisible="False"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="12">
            <controls:CutoutFrame Grid.Column="0"
                                  Classes="tilt-left"
                                  Padding="6">
                <Border Padding="18"
                        Background="{DynamicResource AppBlueSoftBrush}"
                        CornerRadius="2">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="DueCountText"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Localize Today_DueReviews}"
                                   TextWrapping="Wrap"
                                   Opacity="0.7" />
                    </StackPanel>
                </Border>
            </controls:CutoutFrame>
            <controls:CutoutFrame Grid.Column="1"
                                  Padding="6">
                <Border Padding="18"
                        Background="{DynamicResource AppAccentSoftBrush}"
                        CornerRadius="2">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="StrongCountText"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Localize Today_StrongConcepts}"
                                   TextWrapping="Wrap"
                                   Opacity="0.7" />
                    </StackPanel>
                </Border>
            </controls:CutoutFrame>
            <controls:CutoutFrame Grid.Column="2"
                                  Classes="tilt-right"
                                  Padding="6">
                <Border Padding="18"
                        Background="{DynamicResource AppAmberSoftBrush}"
                        CornerRadius="2">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SpeechCountText"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Localize Today_PronunciationTries}"
                                   TextWrapping="Wrap"
                                   Opacity="0.7" />
                    </StackPanel>
                </Border>
            </controls:CutoutFrame>
        </Grid>

        <controls:PaperCard Classes="soft">
            <TextBlock Text="{loc:Localize Today_LocalOnly}"
                       TextWrapping="Wrap"
                       Opacity="0.72" />
        </controls:PaperCard>

        <TextBlock x:Name="ErrorText"
                   IsVisible="False"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppDangerBrush}"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.AutomationId="TodayError" />
    </StackPanel>
</UserControl>
