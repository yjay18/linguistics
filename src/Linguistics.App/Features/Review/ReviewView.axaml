<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Linguistics.App.Controls"
             xmlns:loc="using:Linguistics.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="780"
             x:Class="Linguistics.App.Features.Review.ReviewView">
    <StackPanel Spacing="20">
        <controls:PaperCard Classes="soft">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5">
                    <TextBlock Text="{loc:Localize Review_Intro_Title}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="2" />
                    <TextBlock Text="{loc:Localize Review_Intro_Body}"
                               TextWrapping="Wrap"
                               Opacity="0.76" />
                </StackPanel>
                <Border Grid.Column="1"
                        Margin="20,0,0,0"
                        Classes="status-pill">
                    <TextBlock x:Name="QueueCountText"
                               Text="{loc:Localize Progress_Due}"
                               FontWeight="SemiBold"
                               AutomationProperties.AutomationId="ReviewQueueCount" />
                </Border>
            </Grid>
        </controls:PaperCard>

        <controls:PaperCard x:Name="LoadingState"
                            Classes="soft">
            <StackPanel Spacing="12">
                <ProgressBar IsIndeterminate="True"
                             AutomationProperties.Name="{loc:Localize Review_LoadingName}" />
                <TextBlock Text="{loc:Localize Review_Loading}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </controls:PaperCard>

        <controls:PaperCard x:Name="ContentGateState"
                            IsVisible="False"
                            Classes="soft">
            <StackPanel Spacing="9">
                <TextBlock Text="{loc:Localize Review_Gate_Title}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="2" />
                <TextBlock x:Name="ContentGateMessage"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="ReviewContentGate" />
                <TextBlock Text="{loc:Localize Review_Gate_Body}"
                           TextWrapping="Wrap"
                           Opacity="0.74" />
            </StackPanel>
        </controls:PaperCard>

        <controls:PaperCard x:Name="EmptyState"
                            IsVisible="False"
                            Classes="soft">
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Localize Review_Empty_Title}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="2" />
                <TextBlock x:Name="EmptyMessage"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="ReviewEmptyMessage" />
            </StackPanel>
        </controls:PaperCard>

        <ContentControl x:Name="ReviewFlashHost"
                        IsVisible="False"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="ReviewFlashHost" />

        <TextBlock x:Name="StatusText"
                   IsVisible="False"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.AutomationId="ReviewStatus" />
        <TextBlock x:Name="ErrorText"
                   IsVisible="False"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppDangerBrush}"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.AutomationId="ReviewError" />
    </StackPanel>
</UserControl>
