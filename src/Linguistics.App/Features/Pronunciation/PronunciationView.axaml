<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Linguistics.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="900"
             x:Class="Linguistics.App.Features.Pronunciation.PronunciationView">
    <StackPanel Spacing="18">
        <StackPanel x:Name="LoadingPanel" Spacing="10">
            <ProgressBar IsIndeterminate="True"
                         AutomationProperties.Name="{loc:Localize Pronunciation_LoadingName}" />
            <TextBlock Text="{loc:Localize Pronunciation_Loading}"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <Border x:Name="ContentGatePanel"
                IsVisible="False"
                Classes="warning-card"
                AutomationProperties.AutomationId="PronunciationContentGate">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Localize Pronunciation_Gate_Title}"
                           FontSize="21"
                           FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="2" />
                <TextBlock Text="{loc:Localize Pronunciation_Gate_Body}"
                           TextWrapping="Wrap"
                           LineHeight="22" />
                <TextBlock x:Name="ContentGateTechnicalText"
                           IsVisible="False"
                           TextWrapping="Wrap"
                           Opacity="0.68" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="PracticePanel"
                    IsVisible="False"
                    Spacing="18">
            <Border Classes="hero-card">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Localize Pronunciation_Eyebrow}"
                               Classes="eyebrow" />
                    <TextBlock Text="{loc:Localize Pronunciation_Title}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="2" />
                    <TextBlock Text="{loc:Localize Pronunciation_Body}"
                               TextWrapping="Wrap"
                               LineHeight="22" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Localize Pronunciation_PracticePhrase}"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ExpectedPhraseText"
                               FontSize="28"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="PronunciationExpectedPhrase" />
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Button x:Name="ListenButton"
                                Content="{loc:Localize Pronunciation_Listen}"
                                Classes="primary lift"
                                Click="OnListenClicked"
                                AutomationProperties.AutomationId="PronunciationListen" />
                        <Button x:Name="SlowerButton"
                                Content="{loc:Localize Scenario_Slower}"
                                Classes="quiet"
                                Click="OnSlowerClicked"
                                AutomationProperties.AutomationId="PronunciationListenSlower" />
                        <Button x:Name="StopPlaybackButton"
                                Content="{loc:Localize Pronunciation_StopPlayback}"
                                Classes="quiet"
                                Click="OnStopPlaybackClicked"
                                AutomationProperties.AutomationId="PronunciationStopPlayback" />
                    </StackPanel>
                    <TextBlock x:Name="PlaybackStatusText"
                               TextWrapping="Wrap"
                               Opacity="0.72"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>

            <Border Classes="accent-card">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Localize Scenario_YourReply}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="2" />
                    <TextBlock x:Name="RecognitionStatusText"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.AutomationId="PronunciationRecognitionStatus" />
                    <TextBlock x:Name="SpeechModelDetailsText"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Opacity="0.72" />
                    <Button x:Name="RecordButton"
                            Content="{loc:Localize Pronunciation_Record}"
                            Classes="primary lift"
                            HorizontalAlignment="Left"
                            Click="OnRecordClicked"
                            AutomationProperties.AutomationId="PronunciationRecord" />

                    <Border x:Name="DisclosurePanel"
                            IsVisible="False"
                            Classes="warning-card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:Localize Scenario_MicrophoneDisclosure_Title}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Localize Pronunciation_MicrophoneDisclosure_Body}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Button x:Name="StartRecordingButton"
                                        Content="{loc:Localize Scenario_StartRecording}"
                                        Classes="primary lift"
                                        Click="OnStartRecordingClicked"
                                        AutomationProperties.AutomationId="PronunciationConfirmRecord" />
                                <Button Content="{loc:Localize Scenario_NotNow}"
                                        Classes="quiet"
                                        Click="OnDismissDisclosureClicked"
                                        AutomationProperties.AutomationId="PronunciationDismissRecord" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="RecordingPanel"
                                IsVisible="False"
                                Spacing="10">
                        <ProgressBar IsIndeterminate="True"
                                     AutomationProperties.Name="{loc:Localize Pronunciation_RecordingName}" />
                        <TextBlock Text="{loc:Localize Pronunciation_RecordingBody}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <Button Content="{loc:Localize Scenario_CancelRecording}"
                                HorizontalAlignment="Left"
                                Click="OnCancelRecordingClicked"
                                AutomationProperties.AutomationId="PronunciationCancelRecording" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="ResultPanel"
                    IsVisible="False"
                    Classes="hero-card"
                    AutomationProperties.AutomationId="PronunciationResult">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="OutcomeTitleText"
                               FontSize="22"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="2" />
                    <TextBlock x:Name="OutcomeMessageText"
                               TextWrapping="Wrap"
                               LineHeight="22"
                               AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Text="{loc:Localize Pronunciation_RecognizerHeard}"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="RecognizedPhraseText"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="PronunciationRecognizedPhrase" />
                    <TextBlock x:Name="WordComparisonText"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Localize Pronunciation_ProxyDisclosure}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Opacity="0.72" />
                    <TextBlock x:Name="PersistenceStatusText"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Button Content="{loc:Localize Common_TryAgain}"
                                Classes="primary lift"
                                Click="OnTryAgainClicked"
                                AutomationProperties.AutomationId="PronunciationTryAgain" />
                        <Button x:Name="RetrySaveButton"
                                Content="{loc:Localize Scenario_RetrySave}"
                                IsVisible="False"
                                Click="OnRetrySaveClicked"
                                AutomationProperties.AutomationId="PronunciationRetrySave" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="PreviousAttemptsText"
                       FontSize="13"
                       Opacity="0.72" />
        </StackPanel>
    </StackPanel>
</UserControl>
