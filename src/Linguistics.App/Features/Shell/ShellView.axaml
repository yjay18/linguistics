<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="720"
             x:Class="Linguistics.App.Features.Shell.ShellView">
    <Grid ColumnDefinitions="268,*"
          Background="{DynamicResource AppCanvasBrush}">
        <Border Grid.Column="0"
                Padding="20,28,20,22"
                Background="{DynamicResource AppNavBrush}"
                AutomationProperties.LandmarkType="Navigation">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0"
                      Margin="4,0,4,30"
                      ColumnDefinitions="48,*"
                      ColumnSpacing="13">
                    <Border Width="46"
                            Height="46"
                            CornerRadius="15"
                            Background="{DynamicResource AppGlowBrush}">
                        <TextBlock Text="L"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppNavBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <TextBlock Text="LINGUISTICS"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   LetterSpacing="1.25"
                                   Foreground="{DynamicResource AppNavTextBrush}"
                                   AutomationProperties.HeadingLevel="1" />
                        <TextBlock Text="German, locally"
                                   FontSize="13"
                                   Foreground="{DynamicResource AppNavMutedBrush}" />
                    </StackPanel>
                </Grid>
                <ListBox x:Name="NavigationList"
                         Grid.Row="1"
                         Classes="nav"
                         SelectionMode="Single"
                         AutomationProperties.Name="Main navigation"
                         AutomationProperties.AutomationId="MainNavigation">
                    <ListBoxItem Content="Today"
                                 Tag="Choose one calm next step from your local learning evidence."
                                 AutomationProperties.AutomationId="NavToday" />
                    <ListBoxItem Content="Learn"
                                 Tag="Explore a course path built from short goals, examples, activities, and recaps."
                                 AutomationProperties.AutomationId="NavLearn" />
                    <ListBoxItem Content="Scenarios"
                                 Tag="Practice one complete café exchange with deterministic feedback and local progress."
                                 AutomationProperties.AutomationId="NavScenarios" />
                    <ListBoxItem Content="Pronunciation"
                                 Tag="Practice one approved phrase with system playback and honest local word recognition evidence."
                                 AutomationProperties.AutomationId="NavPronunciation" />
                    <ListBoxItem Content="Review"
                                 Tag="Retrieve due phrases, concepts, pronunciation targets, and recurring forms."
                                 AutomationProperties.AutomationId="NavReview" />
                    <ListBoxItem Content="Progress"
                                 Tag="See practical capabilities first, with concept evidence as supporting detail."
                                 AutomationProperties.AutomationId="NavProgress" />
                    <ListBoxItem Content="Languages"
                                 Tag="Review and edit the languages in your local learner profile."
                                 AutomationProperties.AutomationId="NavLanguages" />
                    <ListBoxItem Content="Settings"
                                 Tag="Review privacy and multilingual preferences or delete your local learner profile."
                                 AutomationProperties.AutomationId="NavSettings" />
                </ListBox>
                <Border Grid.Row="2"
                        Margin="4,24,4,0"
                        Padding="14,12"
                        CornerRadius="13"
                        Background="{DynamicResource AppNavSurfaceBrush}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Width="9"
                                Height="9"
                                CornerRadius="5"
                                Background="{DynamicResource AppNavAccentBrush}"
                                VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="ON DEVICE"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       LetterSpacing="1.1"
                                       Foreground="{DynamicResource AppNavAccentBrush}" />
                            <TextBlock Text="Private by default"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppNavMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Canvas IsHitTestVisible="False"
                    ClipToBounds="True">
                <Ellipse Width="420"
                         Height="420"
                         Canvas.Right="-180"
                         Canvas.Top="-210"
                         Fill="{DynamicResource AppAccentSoftBrush}"
                         Opacity="0.42" />
                <Ellipse Width="300"
                         Height="300"
                         Canvas.Left="-110"
                         Canvas.Bottom="-170"
                         Fill="{DynamicResource AppAmberSoftBrush}"
                         Opacity="0.34" />
            </Canvas>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.LandmarkType="Main">
                <StackPanel Margin="54,44,64,70"
                            MaxWidth="900"
                            HorizontalAlignment="Left"
                            Spacing="28">
                    <StackPanel Spacing="8">
                        <TextBlock Text="YOUR LOCAL LEARNING STUDIO"
                                   Classes="eyebrow" />
                        <TextBlock x:Name="PageTitle"
                                   Classes="display"
                                   AutomationProperties.HeadingLevel="1"
                                   AutomationProperties.AutomationId="PageTitle" />
                        <TextBlock x:Name="PageDescription"
                                   Classes="lede"
                                   MaxWidth="760"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="PageDescription" />
                    </StackPanel>
                    <TransitioningContentControl x:Name="PageContent"
                                                 IsVisible="False"
                                                 AutomationProperties.AutomationId="PageContent" />
                    <Border x:Name="UnavailableState"
                            Classes="warning-card">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Border Width="46"
                                    Height="46"
                                    CornerRadius="23"
                                    Background="{DynamicResource AppAmberBrush}">
                                <TextBlock Text="!"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppNavBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock Text="Protected by a review gate"
                                           Classes="section-title"
                                           AutomationProperties.HeadingLevel="2" />
                                <TextBlock Text="This route opens only when its required teaching content and capability boundaries are approved. Your other local tools remain available."
                                           TextWrapping="Wrap"
                                           LineHeight="22" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
