<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="720"
             x:Class="Linguistics.App.Features.Shell.ShellView">
    <Grid ColumnDefinitions="240,*">
        <Border Grid.Column="0"
                Padding="20,24"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                AutomationProperties.LandmarkType="Navigation">
            <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock Grid.Row="0"
                           Text="Linguistics"
                           FontSize="26"
                           FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="1" />
                <TextBlock Grid.Row="1"
                           Margin="0,4,0,20"
                           Text="Local-first language learning"
                           TextWrapping="Wrap"
                           Opacity="0.72" />
                <ListBox x:Name="NavigationList"
                         Grid.Row="2"
                         SelectionMode="Single"
                         AutomationProperties.Name="Main navigation"
                         AutomationProperties.AutomationId="MainNavigation">
                    <ListBoxItem Content="Today"
                                 Tag="Your local profile is ready. Daily learning arrives with the deterministic curriculum."
                                 AutomationProperties.AutomationId="NavToday" />
                    <ListBoxItem Content="Learn"
                                 Tag="The deterministic curriculum engine is ready. The first content packs remain unavailable to learners until review approval."
                                 AutomationProperties.AutomationId="NavLearn" />
                    <ListBoxItem Content="Scenarios"
                                 Tag="Communicative scenarios are planned for a later milestone."
                                 AutomationProperties.AutomationId="NavScenarios" />
                    <ListBoxItem Content="Pronunciation"
                                 Tag="Local speech and pronunciation practice are not installed yet."
                                 AutomationProperties.AutomationId="NavPronunciation" />
                    <ListBoxItem Content="Review"
                                 Tag="Review becomes available after there is learning progress to schedule."
                                 AutomationProperties.AutomationId="NavReview" />
                    <ListBoxItem Content="Progress"
                                 Tag="Capability-based progress appears after the first learning task."
                                 AutomationProperties.AutomationId="NavProgress" />
                    <ListBoxItem Content="Languages"
                                 Tag="Review and edit the languages in your local learner profile."
                                 AutomationProperties.AutomationId="NavLanguages" />
                    <ListBoxItem Content="Settings"
                                 Tag="Review privacy and multilingual preferences or delete your local learner profile."
                                 AutomationProperties.AutomationId="NavSettings" />
                </ListBox>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1"
                      HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.LandmarkType="Main">
            <StackPanel Margin="48"
                        MaxWidth="720"
                        HorizontalAlignment="Left"
                        Spacing="20">
                <TextBlock x:Name="PageTitle"
                           FontSize="32"
                           FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="1"
                           AutomationProperties.AutomationId="PageTitle" />
                <ContentControl x:Name="PageContent"
                                IsVisible="False"
                                AutomationProperties.AutomationId="PageContent" />
                <Border x:Name="UnavailableState"
                        Padding="24"
                        CornerRadius="12"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Not available yet"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="2" />
                        <TextBlock x:Name="PageDescription"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   AutomationProperties.AutomationId="PageDescription" />
                        <TextBlock Text="The core app remains usable without an account, backend, model, microphone, or network connection."
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
