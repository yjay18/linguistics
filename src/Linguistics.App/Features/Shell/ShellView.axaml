<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Linguistics.App.Controls"
             xmlns:loc="using:Linguistics.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="720"
             x:Class="Linguistics.App.Features.Shell.ShellView">
    <Grid ColumnDefinitions="268,*"
          Background="{DynamicResource AppCanvasBrush}">
        <Border Grid.Column="0"
                Padding="20,28,20,22"
                Background="{DynamicResource AppNavBrush}"
                AutomationProperties.LandmarkType="Navigation">
            <Grid>
                <Border Background="{DynamicResource AppPaperGrainBrush}"
                        IsHitTestVisible="False"
                        Opacity="0.14" />
                <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0"
                      Margin="4,0,4,30"
                      ColumnDefinitions="48,*"
                      ColumnSpacing="13">
                    <controls:CutoutFrame Width="48"
                                          Height="48"
                                          Padding="4"
                                          Classes="tilt-left">
                        <Border CornerRadius="10"
                                Background="{DynamicResource AppGlowBrush}">
                            <TextBlock Text="L"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppNavBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </controls:CutoutFrame>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <TextBlock Text="LINGUISTICS"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   LetterSpacing="1.25"
                                   Foreground="{DynamicResource AppNavTextBrush}"
                                   AutomationProperties.HeadingLevel="1" />
                        <TextBlock Text="{loc:Localize Shell_BrandSubtitle}"
                                   FontSize="13"
                                   Foreground="{DynamicResource AppNavMutedBrush}" />
                    </StackPanel>
                </Grid>
                <ListBox x:Name="NavigationList"
                         Grid.Row="1"
                         Classes="nav"
                         SelectionMode="Single"
                         AutomationProperties.Name="{loc:Localize Shell_MainNavigation}"
                         AutomationProperties.AutomationId="MainNavigation">
                    <ListBoxItem x:Name="TodayNavItem"
                                 Tag="Today"
                                 AutomationProperties.AutomationId="NavToday">
                        <TextBlock Classes="nav-label" Text="{loc:Localize Nav_Today_Title}" />
                    </ListBoxItem>
                    <ListBoxItem x:Name="LearnNavItem"
                                 Tag="Learn"
                                 AutomationProperties.AutomationId="NavLearn">
                        <TextBlock Classes="nav-label" Text="{loc:Localize Nav_Learn_Title}" />
                    </ListBoxItem>
                    <ListBoxItem Tag="Scenarios"
                                 AutomationProperties.AutomationId="NavScenarios">
                        <TextBlock Classes="nav-label" Text="{loc:Localize Nav_Scenarios_Title}" />
                    </ListBoxItem>
                    <ListBoxItem Tag="Pronunciation"
                                 AutomationProperties.AutomationId="NavPronunciation">
                        <TextBlock Classes="nav-label" Text="{loc:Localize Nav_Pronunciation_Title}" />
                    </ListBoxItem>
                    <ListBoxItem Tag="Review"
                                 AutomationProperties.AutomationId="NavReview">
                        <TextBlock Classes="nav-label" Text="{loc:Localize Nav_Review_Title}" />
                    </ListBoxItem>
                    <ListBoxItem x:Name="ProgressNavItem"
                                 Tag="Progress"
                                 AutomationProperties.AutomationId="NavProgress">
                        <TextBlock Classes="nav-label" Text="{loc:Localize Nav_Progress_Title}" />
                    </ListBoxItem>
                    <ListBoxItem Tag="Languages"
                                 AutomationProperties.AutomationId="NavLanguages">
                        <TextBlock Classes="nav-label" Text="{loc:Localize Nav_Languages_Title}" />
                    </ListBoxItem>
                    <ListBoxItem x:Name="SettingsNavItem"
                                 Tag="Settings"
                                 AutomationProperties.AutomationId="NavSettings">
                        <TextBlock Classes="nav-label" Text="{loc:Localize Nav_Settings_Title}" />
                    </ListBoxItem>
                    <ListBoxItem x:Name="TemplateGalleryNavItem"
                                 Tag="TemplateGallery"
                                 IsVisible="False"
                                 AutomationProperties.AutomationId="NavTemplateGallery">
                        <TextBlock Classes="nav-label" Text="Template gallery" />
                    </ListBoxItem>
                    <ListBoxItem x:Name="PaperStageNavItem"
                                 Tag="PaperStage"
                                 IsVisible="False"
                                 AutomationProperties.AutomationId="NavPaperStage">
                        <TextBlock Classes="nav-label" Text="Paper stage" />
                    </ListBoxItem>
                </ListBox>
                <controls:PaperTape Grid.Row="2"
                                    Margin="4,24,4,0"
                                    Content="{loc:Localize Shell_PrivateTape}"
                                    Classes="compact"
                                    Angle="-0.8"
                                    FontSize="10"
                                    AutomationProperties.Name="{loc:Localize Shell_PrivateAutomation}" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Canvas IsHitTestVisible="False"
                    ClipToBounds="True">
                <controls:CutoutFrame Width="390"
                                      Height="210"
                                      Padding="0"
                                      Canvas.Right="-150"
                                      Canvas.Top="-120"
                                      Background="{DynamicResource AppAccentSoftBrush}"
                                      Classes="tilt-right"
                                      Opacity="0.55" />
                <controls:CutoutFrame Width="310"
                                      Height="180"
                                      Padding="0"
                                      Canvas.Left="-105"
                                      Canvas.Bottom="-105"
                                      Background="{DynamicResource AppAmberSoftBrush}"
                                      Classes="tilt-left"
                                      Opacity="0.46" />
            </Canvas>
            <ScrollViewer x:Name="MainScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.LandmarkType="Main">
                <StackPanel Margin="54,44,64,70"
                            MaxWidth="900"
                            HorizontalAlignment="Left"
                            Spacing="28">
                    <StackPanel Spacing="8">
                        <controls:PaperTape Content="{loc:Localize Shell_StudioTape}"
                                            Classes="compact"
                                            Angle="-0.6"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.Name="{loc:Localize Shell_StudioAutomation}" />
                        <TextBlock x:Name="PageTitle"
                                   Classes="display"
                                   AutomationProperties.HeadingLevel="1"
                                   AutomationProperties.AutomationId="PageTitle" />
                        <TextBlock x:Name="PageDescription"
                                   Classes="lede"
                                   MaxWidth="760"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="PageDescription" />
                    </StackPanel>
                    <TransitioningContentControl x:Name="PageContent"
                                                 IsVisible="False"
                                                 AutomationProperties.AutomationId="PageContent" />
                    <Border x:Name="UnavailableState"
                            Classes="warning-card">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Border Width="46"
                                    Height="46"
                                    CornerRadius="23"
                                    Background="{DynamicResource AppAmberBrush}">
                                <TextBlock Text="!"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppNavBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock Text="{loc:Localize Shell_Unavailable_Title}"
                                           Classes="section-title"
                                           AutomationProperties.HeadingLevel="2" />
                                <TextBlock Text="{loc:Localize Shell_Unavailable_Body}"
                                           TextWrapping="Wrap"
                                           LineHeight="22" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
