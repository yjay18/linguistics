<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Linguistics.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="720"
             x:Class="Linguistics.App.Features.Onboarding.OnboardingView">
    <Grid Margin="48,36"
          RowDefinitions="Auto,*,Auto"
          AutomationProperties.LandmarkType="Main">
        <StackPanel Grid.Row="0"
                    MaxWidth="800"
                    HorizontalAlignment="Stretch"
                    Spacing="7">
            <TextBlock Text="PRIVATE, ON DEVICE SETUP"
                       Classes="eyebrow" />
            <TextBlock Text="Shape your learning path"
                       FontSize="25"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="StepText"
                       Classes="muted"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.AutomationId="OnboardingStep" />
            <ProgressBar x:Name="StepProgress"
                         Minimum="1"
                         Maximum="7"
                         AutomationProperties.Name="Onboarding progress" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,28,0,20"
                      HorizontalScrollBarVisibility="Disabled">
            <controls:PaperCard MaxWidth="800"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Padding="38">
                <StackPanel Spacing="20">
                <TextBlock x:Name="QuestionTitle"
                           Classes="display"
                           TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="1"
                           AutomationProperties.AutomationId="OnboardingTitle" />
                <TextBlock x:Name="QuestionBody"
                           FontSize="16"
                           LineHeight="24"
                           TextWrapping="Wrap"
                           Opacity="0.78" />

                <StackPanel x:Name="TargetStep" Spacing="12">
                    <RadioButton x:Name="GermanTarget"
                                 Content="German"
                                 IsChecked="True"
                                 GroupName="TargetLanguage"
                                 AutomationProperties.AutomationId="TargetGerman" />
                    <TextBlock Text="German is the first target configuration. Bundled draft lessons remain gated until linguistic and license review; more languages can arrive through reviewed content packs."
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                </StackPanel>

                <StackPanel x:Name="KnownLanguagesStep"
                            IsVisible="False"
                            Spacing="12">
                    <CheckBox x:Name="EnglishSelected"
                              Content="English"
                              AutomationProperties.AutomationId="KnownEnglish" />
                    <CheckBox x:Name="HindiSelected"
                              Content="Hindi"
                              AutomationProperties.AutomationId="KnownHindi" />
                    <TextBlock Text="Choose any that apply. You may continue without selecting another language."
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                </StackPanel>

                <StackPanel x:Name="LanguageDetailsStep"
                            IsVisible="False"
                            Spacing="18">
                    <TextBlock x:Name="NoKnownLanguagesMessage"
                               Text="You chose not to use another language. You can change this later in Languages."
                               TextWrapping="Wrap"
                               IsVisible="False" />

                    <Border x:Name="EnglishDetails"
                            Classes="soft-card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="English"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       AutomationProperties.HeadingLevel="2" />
                            <TextBlock Text="Approximate proficiency" />
                            <ComboBox x:Name="EnglishProficiency"
                                      SelectedIndex="2"
                                      AutomationProperties.Name="English proficiency"
                                      AutomationProperties.AutomationId="EnglishProficiency">
                                <ComboBoxItem Content="Beginner" Tag="Beginner" />
                                <ComboBoxItem Content="Intermediate" Tag="Intermediate" />
                                <ComboBoxItem Content="Advanced" Tag="Advanced" />
                                <ComboBoxItem Content="Native or nearly native" Tag="NativeOrNearNative" />
                            </ComboBox>
                            <CheckBox x:Name="EnglishReading"
                                      Content="I am comfortable reading English"
                                      IsChecked="True" />
                            <CheckBox x:Name="EnglishListening"
                                      Content="I am comfortable hearing English"
                                      IsChecked="True" />
                            <CheckBox x:Name="EnglishExplanations"
                                      Content="English may be used for explanations"
                                      IsChecked="True" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="HindiDetails"
                            Classes="soft-card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Hindi"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       AutomationProperties.HeadingLevel="2" />
                            <TextBlock Text="Approximate proficiency" />
                            <ComboBox x:Name="HindiProficiency"
                                      SelectedIndex="2"
                                      AutomationProperties.Name="Hindi proficiency"
                                      AutomationProperties.AutomationId="HindiProficiency">
                                <ComboBoxItem Content="Beginner" Tag="Beginner" />
                                <ComboBoxItem Content="Intermediate" Tag="Intermediate" />
                                <ComboBoxItem Content="Advanced" Tag="Advanced" />
                                <ComboBoxItem Content="Native or nearly native" Tag="NativeOrNearNative" />
                            </ComboBox>
                            <CheckBox x:Name="HindiReading"
                                      Content="I am comfortable reading Hindi"
                                      IsChecked="True" />
                            <CheckBox x:Name="HindiListening"
                                      Content="I am comfortable hearing Hindi"
                                      IsChecked="True" />
                            <CheckBox x:Name="HindiExplanations"
                                      Content="Hindi may be used for explanations"
                                      IsChecked="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ShortcutStep"
                            IsVisible="False"
                            Spacing="12">
                    <RadioButton x:Name="ShortcutAutomatic"
                                 Content="Automatic. Show a reviewed comparison when it is useful"
                                 GroupName="ShortcutMode"
                                 IsCheckedChanged="OnShortcutChoiceChanged" />
                    <RadioButton x:Name="ShortcutAskFirst"
                                 Content="Ask first. Let me approve each language switch"
                                 GroupName="ShortcutMode"
                                 IsChecked="True"
                                 IsCheckedChanged="OnShortcutChoiceChanged" />
                    <RadioButton x:Name="ShortcutPreferred"
                                 Content="Use one preferred explanation language"
                                 GroupName="ShortcutMode"
                                 IsCheckedChanged="OnShortcutChoiceChanged" />
                    <RadioButton x:Name="ShortcutNever"
                                 Content="Never. Keep explanations in the target language experience"
                                 GroupName="ShortcutMode"
                                 IsCheckedChanged="OnShortcutChoiceChanged" />
                    <StackPanel x:Name="PreferredLanguagePanel"
                                IsVisible="False"
                                Margin="24,4,0,0"
                                Spacing="8">
                        <TextBlock Text="Preferred explanation language" />
                        <ComboBox x:Name="PreferredLanguage"
                                  AutomationProperties.Name="Preferred explanation language"
                                  AutomationProperties.AutomationId="PreferredLanguage">
                            <ComboBoxItem x:Name="PreferredEnglish" Content="English" Tag="en" />
                            <ComboBoxItem x:Name="PreferredHindi" Content="Hindi" Tag="hi" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="MicrophoneStep"
                            IsVisible="False"
                            Spacing="12">
                    <RadioButton x:Name="MicrophoneNow"
                                 Content="Use the microphone for local speech practice"
                                 GroupName="MicrophonePreference" />
                    <RadioButton x:Name="MicrophoneLater"
                                 Content="Decide later"
                                 GroupName="MicrophonePreference"
                                 IsChecked="True" />
                    <RadioButton x:Name="MicrophoneNever"
                                 Content="Never use the microphone"
                                 GroupName="MicrophonePreference" />
                    <TextBlock Text="Setup does not request microphone permission. If you opt in, the app will ask only when you start a speech action. Text practice remains available."
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                </StackPanel>

                <StackPanel x:Name="MotionStep"
                            IsVisible="False"
                            Spacing="10">
                    <StackPanel Spacing="10">
                        <CheckBox x:Name="ReduceMotion"
                                  Content="Reduce interface motion"
                                  IsChecked="False"
                                  AutomationProperties.AutomationId="OnboardingReduceMotion" />
                        <TextBlock Text="Removes page fades, lifts, and animated state changes while preserving every interaction and status cue."
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ReviewStep"
                            IsVisible="False"
                            Spacing="12">
                    <Border Classes="hero-card">
                        <TextBlock x:Name="ReviewSummary"
                                   TextWrapping="Wrap"
                                   LineHeight="24"
                                   AutomationProperties.AutomationId="OnboardingSummary" />
                    </Border>
                    <TextBlock Text="Your profile stays on this device. No account, analytics, backend, model, microphone, or network connection is required."
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                </StackPanel>
                </StackPanel>
            </controls:PaperCard>
        </ScrollViewer>

        <Grid Grid.Row="2"
              MaxWidth="800"
              HorizontalAlignment="Stretch"
              ColumnDefinitions="*,Auto,Auto">
            <TextBlock x:Name="ErrorText"
                       Grid.Column="0"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppDangerBrush}"
                       IsVisible="False"
                       AutomationProperties.LiveSetting="Assertive"
                       AutomationProperties.AutomationId="OnboardingError" />
            <Button x:Name="BackButton"
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    Classes="quiet"
                    Content="Back"
                    IsEnabled="False"
                    Click="OnBackClicked"
                    AutomationProperties.AutomationId="OnboardingBack" />
            <Button x:Name="ContinueButton"
                    Grid.Column="2"
                    Classes="primary"
                    Content="Continue"
                    Click="OnContinueClicked"
                    AutomationProperties.AutomationId="OnboardingContinue" />
        </Grid>
    </Grid>
</UserControl>
