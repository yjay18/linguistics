<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Linguistics.App.Controls"
             xmlns:loc="using:Linguistics.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="720"
             x:Class="Linguistics.App.Features.Onboarding.OnboardingView">
    <Grid Margin="48,36"
          RowDefinitions="Auto,*,Auto"
          AutomationProperties.LandmarkType="Main">
        <StackPanel Grid.Row="0"
                    MaxWidth="800"
                    HorizontalAlignment="Stretch"
                    Spacing="7">
            <TextBlock Text="{loc:Localize Onboarding_Eyebrow}"
                       Classes="eyebrow" />
            <TextBlock Text="{loc:Localize Onboarding_Heading}"
                       FontSize="25"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="StepText"
                       Classes="muted"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.AutomationId="OnboardingStep" />
            <ProgressBar x:Name="StepProgress"
                         Minimum="1"
                         Maximum="7"
                         AutomationProperties.Name="{loc:Localize Onboarding_Progress}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,28,0,20"
                      HorizontalScrollBarVisibility="Disabled">
            <controls:PaperCard MaxWidth="800"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Padding="38">
                <StackPanel Spacing="20">
                <TextBlock x:Name="QuestionTitle"
                           Classes="display"
                           TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="1"
                           AutomationProperties.AutomationId="OnboardingTitle" />
                <TextBlock x:Name="QuestionBody"
                           FontSize="16"
                           LineHeight="24"
                           TextWrapping="Wrap"
                           Opacity="0.78" />

                <StackPanel x:Name="TargetStep" Spacing="12">
                    <RadioButton x:Name="GermanTarget"
                                 Content="{loc:Localize Language_German}"
                                 IsChecked="True"
                                 GroupName="TargetLanguage"
                                 AutomationProperties.AutomationId="TargetGerman" />
                    <TextBlock Text="{loc:Localize Onboarding_Target_Note}"
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                </StackPanel>

                <StackPanel x:Name="KnownLanguagesStep"
                            IsVisible="False"
                            Spacing="12">
                    <CheckBox x:Name="EnglishSelected"
                              Content="{loc:Localize Language_English}"
                              AutomationProperties.AutomationId="KnownEnglish" />
                    <CheckBox x:Name="HindiSelected"
                              Content="{loc:Localize Language_Hindi}"
                              AutomationProperties.AutomationId="KnownHindi" />
                    <TextBlock Text="{loc:Localize Onboarding_Known_Note}"
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                </StackPanel>

                <StackPanel x:Name="LanguageDetailsStep"
                            IsVisible="False"
                            Spacing="18">
                    <TextBlock x:Name="NoKnownLanguagesMessage"
                               Text="{loc:Localize Onboarding_NoKnownLanguages}"
                               TextWrapping="Wrap"
                               IsVisible="False" />

                    <Border x:Name="EnglishDetails"
                            Classes="soft-card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:Localize Language_English}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       AutomationProperties.HeadingLevel="2" />
                            <TextBlock Text="{loc:Localize Languages_Proficiency}" />
                            <ComboBox x:Name="EnglishProficiency"
                                      SelectedIndex="2"
                                      AutomationProperties.Name="{loc:Localize Languages_EnglishProficiency}"
                                      AutomationProperties.AutomationId="EnglishProficiency">
                                <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Beginner}" Tag="Beginner" />
                                <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Intermediate}" Tag="Intermediate" />
                                <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Advanced}" Tag="Advanced" />
                                <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Native}" Tag="NativeOrNearNative" />
                            </ComboBox>
                            <CheckBox x:Name="EnglishReading"
                                      Content="{loc:Localize Languages_EnglishReading}"
                                      IsChecked="True" />
                            <CheckBox x:Name="EnglishListening"
                                      Content="{loc:Localize Languages_EnglishListening}"
                                      IsChecked="True" />
                            <CheckBox x:Name="EnglishExplanations"
                                      Content="{loc:Localize Languages_EnglishExplanations}"
                                      IsChecked="True" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="HindiDetails"
                            Classes="soft-card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:Localize Language_Hindi}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       AutomationProperties.HeadingLevel="2" />
                            <TextBlock Text="{loc:Localize Languages_Proficiency}" />
                            <ComboBox x:Name="HindiProficiency"
                                      SelectedIndex="2"
                                      AutomationProperties.Name="{loc:Localize Languages_HindiProficiency}"
                                      AutomationProperties.AutomationId="HindiProficiency">
                                <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Beginner}" Tag="Beginner" />
                                <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Intermediate}" Tag="Intermediate" />
                                <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Advanced}" Tag="Advanced" />
                                <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Native}" Tag="NativeOrNearNative" />
                            </ComboBox>
                            <CheckBox x:Name="HindiReading"
                                      Content="{loc:Localize Languages_HindiReading}"
                                      IsChecked="True" />
                            <CheckBox x:Name="HindiListening"
                                      Content="{loc:Localize Languages_HindiListening}"
                                      IsChecked="True" />
                            <CheckBox x:Name="HindiExplanations"
                                      Content="{loc:Localize Languages_HindiExplanations}"
                                      IsChecked="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ShortcutStep"
                            IsVisible="False"
                            Spacing="12">
                    <RadioButton x:Name="ShortcutAutomatic"
                                 Content="{loc:Localize Onboarding_Shortcut_Automatic}"
                                 GroupName="ShortcutMode"
                                 IsCheckedChanged="OnShortcutChoiceChanged" />
                    <RadioButton x:Name="ShortcutAskFirst"
                                 Content="{loc:Localize Onboarding_Shortcut_Ask}"
                                 GroupName="ShortcutMode"
                                 IsChecked="True"
                                 IsCheckedChanged="OnShortcutChoiceChanged" />
                    <RadioButton x:Name="ShortcutPreferred"
                                 Content="{loc:Localize Onboarding_Shortcut_Preferred}"
                                 GroupName="ShortcutMode"
                                 IsCheckedChanged="OnShortcutChoiceChanged" />
                    <RadioButton x:Name="ShortcutNever"
                                 Content="{loc:Localize Onboarding_Shortcut_Never}"
                                 GroupName="ShortcutMode"
                                 IsCheckedChanged="OnShortcutChoiceChanged" />
                    <StackPanel x:Name="PreferredLanguagePanel"
                                IsVisible="False"
                                Margin="24,4,0,0"
                                Spacing="8">
                        <TextBlock Text="{loc:Localize Settings_PreferredLanguage}" />
                        <ComboBox x:Name="PreferredLanguage"
                                  SelectionChanged="OnPreferredLanguageChanged"
                                  AutomationProperties.Name="{loc:Localize Settings_PreferredLanguage}"
                                  AutomationProperties.AutomationId="PreferredLanguage">
                            <ComboBoxItem x:Name="PreferredEnglish" Content="{loc:Localize Language_English}" Tag="en" />
                            <ComboBoxItem x:Name="PreferredHindi" Content="{loc:Localize Language_Hindi}" Tag="hi" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="InstructionSelectionStatus"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.AutomationId="OnboardingInstructionStatus" />
                    <TextBlock Text="{loc:Localize Onboarding_Instruction_Fallback}"
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                </StackPanel>

                <StackPanel x:Name="MicrophoneStep"
                            IsVisible="False"
                            Spacing="12">
                    <RadioButton x:Name="MicrophoneNow"
                                 Content="{loc:Localize Onboarding_Microphone_Now}"
                                 GroupName="MicrophonePreference" />
                    <RadioButton x:Name="MicrophoneLater"
                                 Content="{loc:Localize Onboarding_Microphone_Later}"
                                 GroupName="MicrophonePreference"
                                 IsChecked="True" />
                    <RadioButton x:Name="MicrophoneNever"
                                 Content="{loc:Localize Onboarding_Microphone_Never}"
                                 GroupName="MicrophonePreference" />
                    <TextBlock Text="{loc:Localize Onboarding_Microphone_Note}"
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                </StackPanel>

                <StackPanel x:Name="MotionStep"
                            IsVisible="False"
                            Spacing="10">
                    <StackPanel Spacing="10">
                        <CheckBox x:Name="ReduceMotion"
                                  Content="{loc:Localize Onboarding_Motion_Reduce}"
                                  IsChecked="False"
                                  AutomationProperties.AutomationId="OnboardingReduceMotion" />
                        <TextBlock Text="{loc:Localize Onboarding_Motion_Note}"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ReviewStep"
                            IsVisible="False"
                            Spacing="12">
                    <Border Classes="hero-card">
                        <TextBlock x:Name="ReviewSummary"
                                   TextWrapping="Wrap"
                                   LineHeight="24"
                                   AutomationProperties.AutomationId="OnboardingSummary" />
                    </Border>
                    <TextBlock Text="{loc:Localize Onboarding_Review_Note}"
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                </StackPanel>
                </StackPanel>
            </controls:PaperCard>
        </ScrollViewer>

        <Grid Grid.Row="2"
              MaxWidth="800"
              HorizontalAlignment="Stretch"
              ColumnDefinitions="*,Auto,Auto">
            <TextBlock x:Name="ErrorText"
                       Grid.Column="0"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppDangerBrush}"
                       IsVisible="False"
                       AutomationProperties.LiveSetting="Assertive"
                       AutomationProperties.AutomationId="OnboardingError" />
            <Button x:Name="BackButton"
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    Classes="quiet"
                    Content="{loc:Localize Common_Back}"
                    IsEnabled="False"
                    Click="OnBackClicked"
                    AutomationProperties.AutomationId="OnboardingBack" />
            <Button x:Name="ContinueButton"
                    Grid.Column="2"
                    Classes="primary"
                    Content="{loc:Localize Common_Continue}"
                    Click="OnContinueClicked"
                    AutomationProperties.AutomationId="OnboardingContinue" />
        </Grid>
    </Grid>
</UserControl>
