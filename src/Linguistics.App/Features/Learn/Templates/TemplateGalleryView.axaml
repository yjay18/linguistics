<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Linguistics.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="860"
             d:DesignHeight="760"
             x:Class="Linguistics.App.Features.Learn.Templates.TemplateGalleryView">
    <StackPanel Spacing="18">
        <controls:PaperCard>
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="24">
                <StackPanel Spacing="7">
                    <TextBlock Text="Synthetic template fixtures"
                               Classes="section-title"
                               AutomationProperties.HeadingLevel="2" />
                    <TextBlock Text="This gallery uses fixed local examples only. It reads no learner history and saves nothing."
                               Classes="muted"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="OutcomeText"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppAccentTextBrush}"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.AutomationId="TemplateGalleryOutcome" />
                    <CheckBox x:Name="TextOnlyCheckBox"
                              Content="Show text only fallback"
                              IsCheckedChanged="OnTextOnlyChanged"
                              AutomationProperties.AutomationId="TemplateGalleryTextOnly" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="primary lift"
                        Content="Next outcome"
                        VerticalAlignment="Center"
                        Click="OnNextOutcomeClicked"
                        AutomationProperties.AutomationId="TemplateGalleryNextOutcome" />
            </Grid>
        </controls:PaperCard>

        <Border x:Name="EmptyState"
                Classes="warning-card"
                IsVisible="False">
            <StackPanel Spacing="7">
                <TextBlock Text="Gallery ready"
                           Classes="section-title"
                           AutomationProperties.HeadingLevel="2" />
                <TextBlock Text="No template fixtures are available. Check local content and renderer registration."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <controls:PaperCard x:Name="SeedBatchCard"
                            IsVisible="False">
            <StackPanel Spacing="12">
                <StackPanel Spacing="5">
                    <TextBlock Text="Unit 1 and 2 seed batch"
                               Classes="section-title"
                               AutomationProperties.HeadingLevel="2" />
                    <TextBlock Text="This contact sheet checks local Unit 1 and 2 images. It is not a curriculum activity."
                               Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel x:Name="SeedAssetPanel"
                           ItemWidth="174"
                           ItemHeight="174"
                           Orientation="Horizontal"
                           AutomationProperties.AutomationId="TemplateGallerySeedAssets" />
                <ContentControl x:Name="SeedCreditsHost"
                                HorizontalContentAlignment="Stretch" />
            </StackPanel>
        </controls:PaperCard>

        <StackPanel x:Name="FixturePanel"
                    Spacing="20"
                    AutomationProperties.AutomationId="TemplateGalleryFixtures" />
    </StackPanel>
</UserControl>
