<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Linguistics.App.Controls"
             xmlns:learn="using:Linguistics.App.Features.Learn"
             xmlns:loc="using:Linguistics.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="860"
             d:DesignHeight="760"
             x:Class="Linguistics.App.Features.Learn.LearnView">
    <Grid>
        <StackPanel x:Name="CoursePanel"
                    Spacing="22">
            <Border x:Name="PreviewNotice"
                    Classes="warning-card"
                    IsVisible="False">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="{DynamicResource AppAmberBrush}">
                        <TextBlock Text="P"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppNavBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{loc:Localize Learn_Preview_Title}"
                                   FontWeight="SemiBold"
                                   FontSize="17"
                                   AutomationProperties.HeadingLevel="2" />
                        <TextBlock Text="{loc:Localize Learn_Preview_Body}"
                                   TextWrapping="Wrap"
                                   Opacity="0.82" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Classes="hero-card">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="28">
                    <StackPanel Grid.Column="0" Spacing="13">
                        <TextBlock Text="{loc:Localize Learn_Course_Eyebrow}"
                                   Classes="eyebrow" />
                        <TextBlock x:Name="CourseTitleText"
                                   Text="{loc:Localize Learn_GermanFoundations}"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   LineHeight="39"
                                   AutomationProperties.HeadingLevel="2"
                                   AutomationProperties.AutomationId="CourseTitle" />
                        <TextBlock x:Name="CourseAvailabilityText"
                                   TextWrapping="Wrap"
                                   FontSize="16"
                                   Opacity="0.78"
                                   AutomationProperties.AutomationId="CourseAvailability" />
                        <ProgressBar x:Name="CatalogProgress"
                                     MaxWidth="520"
                                     HorizontalAlignment="Stretch"
                                     AutomationProperties.Name="{loc:Localize Learn_CourseCapacity}" />
                        <TextBlock x:Name="PlannedContentText"
                                   Classes="muted"
                                   TextWrapping="Wrap"
                                   FontSize="13" />
                        <Button x:Name="StartCourseButton"
                                Classes="primary lift"
                                Content="{loc:Localize Learn_StartFirstLesson}"
                                HorizontalAlignment="Left"
                                Click="OnStartCourseClicked"
                                AutomationProperties.AutomationId="StartCourse" />
                        <TextBlock x:Name="SessionStatusText"
                                   IsVisible="False"
                                   Foreground="{DynamicResource AppAccentTextBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.AutomationId="LessonSessionStatus" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Width="132"
                            Height="132"
                            CornerRadius="66"
                            Background="{DynamicResource AppAccentBrush}"
                            VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="1">
                            <TextBlock x:Name="AuthoredCountText"
                                       FontSize="38"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppOnAccentBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Localize Learn_Lessons}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       LetterSpacing="1.2"
                                       Foreground="{DynamicResource AppOnAccentBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Spacing="12">
                <TextBlock Text="{loc:Localize Learn_CoursePath_Title}"
                           Classes="section-title"
                           AutomationProperties.HeadingLevel="2" />
                <TextBlock Text="{loc:Localize Learn_CoursePath_Body}"
                           Classes="muted"
                           TextWrapping="Wrap" />
                <Grid AutomationProperties.AutomationId="CourseUnits">
                    <Border Width="3"
                            Margin="30,26,0,56"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource AppAccentBrush}"
                            CornerRadius="2"
                            IsHitTestVisible="False"
                            AutomationProperties.AccessibilityView="Raw" />
                    <ItemsControl x:Name="UnitsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="22" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="learn:CourseJourneyUnit">
                                <Grid ColumnDefinitions="64,*"
                                      ColumnSpacing="12">
                                    <controls:PaperStamp Width="54"
                                                         Height="54"
                                                         Margin="4,18,0,0"
                                                         VerticalAlignment="Top"
                                                         Content="{Binding Number}"
                                                         FontSize="16"
                                                         Angle="-2"
                                                         AutomationProperties.Name="{Binding UnitAutomationName}" />
                                    <controls:PaperCard Grid.Column="1"
                                                        Padding="22"
                                                        AutomationProperties.Name="{Binding UnitAutomationName}">
                                        <StackPanel Spacing="15">
                                            <StackPanel Spacing="7">
                                                <controls:PaperTape Content="{Binding UnitLabel}"
                                                                    Classes="compact"
                                                                    Angle="1"
                                                                    HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="21"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           AutomationProperties.HeadingLevel="3" />
                                                <TextBlock Text="{Binding Description}"
                                                           Classes="muted"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Lessons}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="learn:CourseJourneyLesson">
                                                        <Button Width="246"
                                                                MinHeight="126"
                                                                Margin="0,0,10,10"
                                                                Classes="lesson-tile lift"
                                                                Tag="{Binding Lesson}"
                                                                Click="OnLessonClicked"
                                                                AutomationProperties.Name="{Binding AutomationName}">
                                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                                                  RowSpacing="5">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="{Binding NumberLabel}"
                                                                               Classes="lesson-label"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               LetterSpacing="1.1" />
                                                                    <controls:PaperTape Grid.Column="1"
                                                                                        IsVisible="{Binding IsNext}"
                                                                                        Content="{loc:Localize Learn_Journey_Next}"
                                                                                        Classes="compact"
                                                                                        Angle="2"
                                                                                        FontSize="9" />
                                                                </Grid>
                                                                <TextBlock Grid.Row="1"
                                                                           Text="{Binding Title}"
                                                                           FontSize="16"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="Wrap"
                                                                           MaxLines="2" />
                                                                <TextBlock Grid.Row="2"
                                                                           Text="{Binding CardCount}"
                                                                           Classes="muted"
                                                                           FontSize="12" />
                                                                <StackPanel Grid.Row="3"
                                                                            Orientation="Horizontal"
                                                                            Spacing="6">
                                                                    <Border Classes="status-pill"
                                                                            Padding="8,3">
                                                                        <TextBlock Text="{Binding PresentationKind}"
                                                                                   FontSize="10"
                                                                                   FontWeight="SemiBold" />
                                                                    </Border>
                                                                    <Border Classes="status-pill"
                                                                            Padding="8,3">
                                                                        <TextBlock Text="{Binding ReviewState}"
                                                                                   FontSize="10"
                                                                                   FontWeight="SemiBold" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </controls:PaperCard>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <controls:PaperCard Classes="soft"
                                    Margin="64,0,0,0"
                                    Padding="20"
                                    AutomationProperties.AutomationId="CoursePlannedPath">
                    <StackPanel Spacing="8">
                        <controls:PaperTape Content="{loc:Localize Learn_Journey_Planned}"
                                            Classes="compact"
                                            Angle="-1"
                                            HorizontalAlignment="Left" />
                        <TextBlock x:Name="PlannedPathText"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{loc:Localize Learn_Journey_PlannedBody}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </controls:PaperCard>
            </StackPanel>

            <Expander x:Name="DeveloperDetails"
                      Header="Developer details"
                      IsVisible="False"
                      AutomationProperties.AutomationId="DeveloperCourseDetails">
                <Border Padding="18">
                    <ContentControl x:Name="DeveloperDetailsContent" />
                </Border>
            </Expander>
        </StackPanel>

        <StackPanel x:Name="LessonPanel"
                    IsVisible="False"
                    Spacing="18"
                    AutomationProperties.AutomationId="LessonPlayer">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="14">
                <Button Grid.Column="0"
                        Classes="quiet"
                        Content="{loc:Localize Learn_CourseMap}"
                        Click="OnCloseLessonClicked"
                        AutomationProperties.AutomationId="CloseLesson" />
                <TextBlock x:Name="LessonPositionText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Classes="muted"
                           AutomationProperties.Name="{loc:Localize Learn_LessonPosition}" />
                <Border Grid.Column="2"
                        Classes="status-pill">
                    <TextBlock x:Name="LessonLevelText"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>

            <ProgressBar x:Name="LessonProgress"
                         AutomationProperties.Name="{loc:Localize Learn_LessonProgress}" />

            <TransitioningContentControl x:Name="SlideHost"
                                         MinHeight="390"
                                         AutomationProperties.AutomationId="LessonSlide" />

            <TextBlock x:Name="LessonTemplateOutcomeText"
                       IsVisible="False"
                       Foreground="{DynamicResource AppAccentTextBrush}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.AutomationId="LessonTemplateOutcome" />

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="16">
                <Button x:Name="BackButton"
                        Grid.Column="0"
                        MinWidth="126"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Classes="quiet"
                        Content="{loc:Localize Common_Back}"
                        Click="OnBackClicked"
                        AutomationProperties.AutomationId="LessonBack" />
                <Button x:Name="ContinueButton"
                        Grid.Column="2"
                        MinWidth="126"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Classes="primary lift"
                        Content="{loc:Localize Common_Continue}"
                        Click="OnContinueClicked"
                        AutomationProperties.AutomationId="LessonContinue" />
            </Grid>
        </StackPanel>

        <Border x:Name="ErrorPanel"
                Classes="warning-card"
                IsVisible="False">
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Localize Learn_Unavailable_Title}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="2" />
                <TextBlock x:Name="ErrorText"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
