<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Linguistics.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="780"
             x:Class="Linguistics.App.Features.Progress.ProgressView">
    <StackPanel Spacing="22">
        <controls:PaperCard x:Name="LoadingState"
                            Classes="soft">
            <StackPanel Spacing="12">
                <ProgressBar IsIndeterminate="True"
                             AutomationProperties.Name="Loading local progress" />
                <TextBlock Text="Reading capability evidence…"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </controls:PaperCard>

        <controls:PaperCard x:Name="CapabilityCard"
                            IsVisible="False"
                            Padding="28"
                            Background="{DynamicResource AppPaperAltBrush}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                <controls:PaperStamp x:Name="CapabilityGlyph"
                                     Width="72"
                                     Height="72"
                                     Content="○"
                                     FontSize="28"
                                     Angle="-2"
                                     AutomationProperties.Name="Capability status" />
                <StackPanel Grid.Column="1" Spacing="7">
                    <controls:PaperTape Content="COMMUNICATIVE CAPABILITY"
                                        Classes="compact"
                                        Angle="1"
                                        HorizontalAlignment="Left" />
                    <TextBlock x:Name="CapabilityTitle"
                               FontSize="26"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               AutomationProperties.HeadingLevel="2"
                               AutomationProperties.AutomationId="CapabilityTitle" />
                    <TextBlock x:Name="CapabilityDescription"
                               TextWrapping="Wrap"
                               Opacity="0.78" />
                    <TextBlock x:Name="CapabilityEvidence"
                               Margin="0,4,0,0"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="CapabilityEvidence" />
                </StackPanel>
            </Grid>
        </controls:PaperCard>

        <controls:PaperTape x:Name="ConceptHeading"
                            Content="CONCEPT EVIDENCE"
                            Classes="compact"
                            Angle="-1"
                            FontSize="12"
                            HorizontalAlignment="Left"
                            IsVisible="False"
                            AutomationProperties.Name="Concept evidence"
                            AutomationProperties.HeadingLevel="2" />
        <Grid x:Name="ConceptGrid"
              IsVisible="False"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="12">
            <controls:CutoutFrame Grid.Column="0"
                                  Classes="tilt-left"
                                  Padding="6">
                <Border Padding="18"
                        Background="{DynamicResource AppBlueSoftBrush}"
                        CornerRadius="2">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="PracticingCount"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="practicing"
                                   Opacity="0.7" />
                    </StackPanel>
                </Border>
            </controls:CutoutFrame>
            <controls:CutoutFrame Grid.Column="1"
                                  Padding="6">
                <Border Padding="18"
                        Background="{DynamicResource AppAccentSoftBrush}"
                        CornerRadius="2">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="StrongCount"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="strong"
                                   Opacity="0.7" />
                    </StackPanel>
                </Border>
            </controls:CutoutFrame>
            <controls:CutoutFrame Grid.Column="2"
                                  Classes="tilt-right"
                                  Padding="6">
                <Border Padding="18"
                        Background="{DynamicResource AppAmberSoftBrush}"
                        CornerRadius="2">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="DueCount"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="due"
                                   Opacity="0.7" />
                    </StackPanel>
                </Border>
            </controls:CutoutFrame>
        </Grid>

        <controls:PaperCard x:Name="MethodCard"
                            IsVisible="False"
                            Classes="soft">
            <StackPanel Spacing="7">
                <TextBlock Text="How this is calculated"
                           FontSize="18"
                           FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="2" />
                <TextBlock Text="A capability becomes demonstrated only after a stored task attempt says the practical goal succeeded. Accuracy, fluency, pronunciation, and target concept evidence remain separate. Review can strengthen or return a concept to practice through versioned deterministic rules."
                           TextWrapping="Wrap"
                           Opacity="0.74" />
            </StackPanel>
        </controls:PaperCard>

        <TextBlock x:Name="ErrorText"
                   IsVisible="False"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppDangerBrush}"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.AutomationId="ProgressError" />
    </StackPanel>
</UserControl>
