<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Linguistics.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="720"
             d:DesignHeight="760"
             x:Class="Linguistics.App.Features.Languages.LanguagesView">
    <StackPanel Spacing="20">
        <Border Classes="hero-card">
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Localize Languages_Target_Title}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="2" />
                <TextBlock Text="{loc:Localize Language_German}" FontSize="16" />
                <TextBlock Text="{loc:Localize Languages_Target_Body}"
                           TextWrapping="Wrap"
                           Opacity="0.72" />
            </StackPanel>
        </Border>

        <StackPanel Spacing="12">
            <TextBlock Text="{loc:Localize Languages_Known_Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="2" />
            <TextBlock Text="{loc:Localize Languages_Known_Body}"
                       TextWrapping="Wrap"
                       Opacity="0.78" />
            <CheckBox x:Name="EnglishSelected"
                      Content="{loc:Localize Language_English}"
                      IsCheckedChanged="OnLanguageSelectionChanged"
                      AutomationProperties.AutomationId="LanguagesEnglish" />
            <Border x:Name="EnglishDetails"
                    Margin="24,0,0,0"
                    Classes="soft-card">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Localize Languages_EnglishPreferences}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="3" />
                    <TextBlock Text="{loc:Localize Languages_Proficiency}" />
                    <ComboBox x:Name="EnglishProficiency"
                              AutomationProperties.Name="{loc:Localize Languages_EnglishProficiency}">
                        <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Beginner}" Tag="Beginner" />
                        <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Intermediate}" Tag="Intermediate" />
                        <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Advanced}" Tag="Advanced" />
                        <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Native}" Tag="NativeOrNearNative" />
                    </ComboBox>
                    <CheckBox x:Name="EnglishReading"
                              Content="{loc:Localize Languages_EnglishReading}"
                              IsCheckedChanged="OnLanguageDetailsChanged" />
                    <CheckBox x:Name="EnglishListening"
                              Content="{loc:Localize Languages_EnglishListening}" />
                    <CheckBox x:Name="EnglishExplanations"
                              Content="{loc:Localize Languages_EnglishExplanations}"
                              IsCheckedChanged="OnLanguageDetailsChanged" />
                </StackPanel>
            </Border>

            <CheckBox x:Name="HindiSelected"
                      Content="{loc:Localize Language_Hindi}"
                      IsCheckedChanged="OnLanguageSelectionChanged"
                      AutomationProperties.AutomationId="LanguagesHindi" />
            <Border x:Name="HindiDetails"
                    Margin="24,0,0,0"
                    Classes="soft-card">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Localize Languages_HindiPreferences}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="3" />
                    <TextBlock Text="{loc:Localize Languages_Proficiency}" />
                    <ComboBox x:Name="HindiProficiency"
                              AutomationProperties.Name="{loc:Localize Languages_HindiProficiency}">
                        <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Beginner}" Tag="Beginner" />
                        <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Intermediate}" Tag="Intermediate" />
                        <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Advanced}" Tag="Advanced" />
                        <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Native}" Tag="NativeOrNearNative" />
                    </ComboBox>
                    <CheckBox x:Name="HindiReading"
                              Content="{loc:Localize Languages_HindiReading}"
                              IsCheckedChanged="OnLanguageDetailsChanged" />
                    <CheckBox x:Name="HindiListening"
                              Content="{loc:Localize Languages_HindiListening}" />
                    <CheckBox x:Name="HindiExplanations"
                              Content="{loc:Localize Languages_HindiExplanations}"
                              IsCheckedChanged="OnLanguageDetailsChanged" />
                </StackPanel>
            </Border>

            <CheckBox x:Name="HinglishSelected"
                      Content="{loc:Localize Language_Hinglish}"
                      IsCheckedChanged="OnLanguageSelectionChanged"
                      AutomationProperties.AutomationId="LanguagesHinglish" />
            <Border x:Name="HinglishDetails"
                    Margin="24,0,0,0"
                    Classes="soft-card">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Localize Languages_HinglishPreferences}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="3" />
                    <TextBlock Text="{loc:Localize Languages_Proficiency}" />
                    <ComboBox x:Name="HinglishProficiency"
                              AutomationProperties.Name="{loc:Localize Languages_HinglishProficiency}">
                        <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Beginner}" Tag="Beginner" />
                        <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Intermediate}" Tag="Intermediate" />
                        <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Advanced}" Tag="Advanced" />
                        <ComboBoxItem Content="{loc:Localize Languages_Proficiency_Native}" Tag="NativeOrNearNative" />
                    </ComboBox>
                    <CheckBox x:Name="HinglishReading"
                              Content="{loc:Localize Languages_HinglishReading}"
                              IsCheckedChanged="OnLanguageDetailsChanged" />
                    <CheckBox x:Name="HinglishListening"
                              Content="{loc:Localize Languages_HinglishListening}" />
                    <CheckBox x:Name="HinglishExplanations"
                              Content="{loc:Localize Languages_HinglishExplanations}"
                              IsCheckedChanged="OnLanguageDetailsChanged" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Classes="hero-card">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Localize Languages_Instruction_Title}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="2" />
                <TextBlock Text="{loc:Localize Languages_Instruction_Body}"
                           TextWrapping="Wrap"
                           Opacity="0.78" />
                <ComboBox x:Name="InstructionLanguage"
                          MinWidth="300"
                          SelectionChanged="OnInstructionLanguageChanged"
                          AutomationProperties.Name="{loc:Localize Languages_Instruction_Label}"
                          AutomationProperties.AutomationId="LanguagesInstructionLanguage">
                    <ComboBoxItem x:Name="InstructionAutomatic"
                                  Content="{loc:Localize Languages_Instruction_Automatic}"
                                  Tag="auto" />
                    <ComboBoxItem x:Name="InstructionEnglish"
                                  Content="{loc:Localize Language_English}"
                                  Tag="en" />
                    <ComboBoxItem x:Name="InstructionHindi"
                                  Content="{loc:Localize Language_Hindi}"
                                  Tag="hi" />
                    <ComboBoxItem x:Name="InstructionHinglish"
                                  Content="{loc:Localize Language_Hinglish}"
                                  Tag="hi-latn" />
                </ComboBox>
                <TextBlock x:Name="InstructionStatus"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.AutomationId="LanguagesInstructionStatus" />
                <TextBlock Text="{loc:Localize Languages_Instruction_Fallback}"
                           TextWrapping="Wrap"
                           Opacity="0.72" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText"
                   IsVisible="False"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppDangerBrush}"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.AutomationId="LanguagesError" />
        <TextBlock x:Name="StatusText"
                   IsVisible="False"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.AutomationId="LanguagesStatus" />
        <Button x:Name="SaveButton"
                Content="{loc:Localize Languages_Save}"
                Classes="primary lift"
                HorizontalAlignment="Left"
                Click="OnSaveClicked"
                AutomationProperties.AutomationId="SaveLanguages" />
    </StackPanel>
</UserControl>
