<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Linguistics.App.Controls"
             xmlns:loc="using:Linguistics.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="720"
             d:DesignHeight="900"
             x:Class="Linguistics.App.Features.Settings.SettingsView">
    <StackPanel Spacing="24">
        <controls:PaperCard Classes="settings-sheet soft">
            <StackPanel Spacing="12">
                <TextBlock Text="{loc:Localize Settings_AppLanguage_Title}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="2" />
                <TextBlock Text="{loc:Localize Settings_AppLanguage_Description}"
                           TextWrapping="Wrap"
                           Opacity="0.78" />
                <ComboBox x:Name="AppLanguageOverride"
                          MinWidth="300"
                          AutomationProperties.Name="{loc:Localize Settings_AppLanguage_Label}"
                          AutomationProperties.AutomationId="SettingsAppLanguage">
                    <ComboBoxItem x:Name="FollowInstructionLanguage"
                                  Content="{loc:Localize Language_FollowInstruction}" />
                    <ComboBoxItem x:Name="AppLanguageEnglish"
                                  Content="{loc:Localize Language_English}" />
                    <ComboBoxItem x:Name="AppLanguageHindi"
                                  Content="{loc:Localize Language_Hindi}" />
                </ComboBox>
            </StackPanel>
        </controls:PaperCard>

        <controls:PaperCard Classes="settings-sheet">
            <StackPanel Spacing="12">
            <TextBlock Text="{loc:Localize Settings_Shortcuts_Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="2" />
            <TextBlock Text="{loc:Localize Settings_Shortcuts_Body}"
                       TextWrapping="Wrap"
                       Opacity="0.78" />
            <RadioButton x:Name="ShortcutAutomatic"
                         Content="{loc:Localize Settings_Shortcuts_Automatic}"
                         GroupName="SettingsShortcutMode"
                         IsCheckedChanged="OnShortcutChoiceChanged" />
            <RadioButton x:Name="ShortcutAskFirst"
                         Content="{loc:Localize Settings_Shortcuts_AskFirst}"
                         GroupName="SettingsShortcutMode"
                         IsCheckedChanged="OnShortcutChoiceChanged" />
            <RadioButton x:Name="ShortcutPreferred"
                         Content="{loc:Localize Settings_Shortcuts_Preferred}"
                         GroupName="SettingsShortcutMode"
                         IsCheckedChanged="OnShortcutChoiceChanged" />
            <RadioButton x:Name="ShortcutNever"
                         Content="{loc:Localize Settings_Shortcuts_Never}"
                         GroupName="SettingsShortcutMode"
                         IsCheckedChanged="OnShortcutChoiceChanged" />
            <StackPanel x:Name="PreferredLanguagePanel"
                        Margin="24,4,0,0"
                        Spacing="8"
                        IsVisible="False">
                <TextBlock Text="{loc:Localize Settings_PreferredLanguage}" />
                <ComboBox x:Name="PreferredLanguage"
                          AutomationProperties.Name="{loc:Localize Settings_PreferredLanguage}"
                          AutomationProperties.AutomationId="SettingsPreferredLanguage">
                    <ComboBoxItem x:Name="PreferredEnglish" Content="{loc:Localize Language_English}" Tag="en" />
                    <ComboBoxItem x:Name="PreferredHindi" Content="{loc:Localize Language_Hindi}" Tag="hi" />
                </ComboBox>
            </StackPanel>
            </StackPanel>
        </controls:PaperCard>

        <controls:PaperCard Classes="settings-sheet soft">
            <StackPanel Spacing="12">
            <TextBlock Text="{loc:Localize Settings_LocalModel_Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="2" />
            <TextBlock Text="{loc:Localize Settings_LocalModel_Body}"
                       TextWrapping="Wrap"
                       Opacity="0.78" />
            <Button x:Name="CheckOllamaButton"
                    Content="{loc:Localize Settings_LocalModel_Check}"
                    Classes="quiet"
                    HorizontalAlignment="Left"
                    Click="OnCheckOllamaClicked"
                    AutomationProperties.AutomationId="CheckLocalOllama" />
            <TextBlock x:Name="ModelServiceStatus"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.AutomationId="LocalModelServiceStatus" />
            <TextBlock Text="{loc:Localize Settings_LocalModel_Field}" />
            <ComboBox x:Name="ModelSelection"
                      MinWidth="360"
                      SelectionChanged="OnModelSelectionChanged"
                      AutomationProperties.Name="{loc:Localize Settings_LocalModel_Title}"
                      AutomationProperties.AutomationId="LocalModelSelection" />
            <TextBlock x:Name="ModelDetailsText"
                       TextWrapping="Wrap"
                       Opacity="0.76"
                       AutomationProperties.AutomationId="LocalModelDetails" />
            <TextBlock Text="{loc:Localize Settings_LocalModel_Disclaimer}"
                       TextWrapping="Wrap"
                       Opacity="0.72" />
            </StackPanel>
        </controls:PaperCard>

        <controls:PaperCard Classes="settings-sheet">
            <StackPanel Spacing="12">
            <TextBlock Text="{loc:Localize Settings_Speech_Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="2" />
            <TextBlock Text="{loc:Localize Settings_Speech_Body}"
                       TextWrapping="Wrap"
                       Opacity="0.78" />
            <Button x:Name="CheckSpeechButton"
                    Content="{loc:Localize Settings_Speech_Check}"
                    Classes="quiet"
                    HorizontalAlignment="Left"
                    Click="OnCheckSpeechClicked"
                    AutomationProperties.AutomationId="CheckLocalSpeech" />
            <TextBlock x:Name="SpeechServiceStatus"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.AutomationId="LocalSpeechStatus" />
            <TextBlock x:Name="SpeechModelDetailsText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Opacity="0.72"
                       AutomationProperties.AutomationId="LocalSpeechModelDetails" />
            </StackPanel>
        </controls:PaperCard>

        <controls:PaperCard Classes="settings-sheet soft">
            <StackPanel Spacing="12">
            <TextBlock Text="{loc:Localize Settings_Microphone_Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="2" />
            <RadioButton x:Name="MicrophoneNow"
                         Content="{loc:Localize Settings_Microphone_Now}"
                         GroupName="SettingsMicrophonePreference" />
            <RadioButton x:Name="MicrophoneLater"
                         Content="{loc:Localize Settings_Microphone_Later}"
                         GroupName="SettingsMicrophonePreference" />
            <RadioButton x:Name="MicrophoneNever"
                         Content="{loc:Localize Settings_Microphone_Never}"
                         GroupName="SettingsMicrophonePreference" />
            <TextBlock Text="{loc:Localize Settings_Microphone_Body}"
                       TextWrapping="Wrap"
                       Opacity="0.72" />
            </StackPanel>
        </controls:PaperCard>

        <controls:PaperCard Classes="settings-sheet">
            <StackPanel Spacing="12">
            <TextBlock Text="{loc:Localize Settings_LegacyAudio_Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="2" />
            <TextBlock Text="{loc:Localize Settings_LegacyAudio_Body}"
                       TextWrapping="Wrap"
                       Opacity="0.72" />
            <Button x:Name="DeleteSpeechRecordingsButton"
                    Content="{loc:Localize Settings_LegacyAudio_Delete}"
                    Classes="quiet"
                    HorizontalAlignment="Left"
                    Click="OnDeleteSpeechRecordingsClicked"
                    AutomationProperties.AutomationId="DeleteSpeechRecordings" />
            <TextBlock x:Name="SpeechDeletionStatusText"
                       IsVisible="False"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Assertive"
                       AutomationProperties.AutomationId="SpeechDeletionStatus" />
            </StackPanel>
        </controls:PaperCard>

        <controls:PaperCard Classes="settings-sheet soft">
            <StackPanel Spacing="12">
            <TextBlock Text="{loc:Localize Settings_Motion_Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="2" />
            <CheckBox x:Name="ReduceMotion"
                      Content="{loc:Localize Settings_Motion_Reduce}"
                      AutomationProperties.AutomationId="SettingsReduceMotion" />
            <TextBlock Text="{loc:Localize Settings_Motion_Body}"
                       TextWrapping="Wrap"
                       Opacity="0.72" />
            </StackPanel>
        </controls:PaperCard>

        <TextBlock x:Name="ErrorText"
                   IsVisible="False"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppDangerBrush}"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.AutomationId="SettingsError" />
        <TextBlock x:Name="StatusText"
                   IsVisible="False"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.AutomationId="SettingsStatus" />
        <Button x:Name="SaveButton"
                Content="{loc:Localize Settings_Save}"
                Classes="primary lift"
                HorizontalAlignment="Left"
                Click="OnSaveClicked"
                AutomationProperties.AutomationId="SaveSettings" />

        <controls:PaperCard Classes="settings-sheet soft"
                            AutomationProperties.AutomationId="ImageCreditsCard">
            <StackPanel Spacing="12">
                <TextBlock Text="{loc:Localize Settings_Images_Title}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="2" />
                <TextBlock x:Name="AssetCreditsSummary"
                           Text="{loc:Localize Settings_Images_None}"
                           TextWrapping="Wrap"
                           Opacity="0.78"
                           AutomationProperties.AutomationId="ImageCreditsSummary" />
                <TextBlock Text="{loc:Localize Settings_Images_Disclaimer}"
                           TextWrapping="Wrap"
                           Opacity="0.72" />
                <StackPanel x:Name="AssetCreditsPanel"
                            Spacing="10"
                            AutomationProperties.AutomationId="ImageCreditsList" />
            </StackPanel>
        </controls:PaperCard>

        <controls:PaperCard Classes="danger">
            <StackPanel Spacing="12">
                <TextBlock Text="{loc:Localize Settings_Delete_Title}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="2" />
                <TextBlock Text="{loc:Localize Settings_Delete_BodyOne}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{loc:Localize Settings_Delete_BodyTwo}"
                           TextWrapping="Wrap" />
                <Button x:Name="ShowDeleteConfirmationButton"
                        Content="{loc:Localize Settings_Delete_Action}"
                        Classes="danger"
                        HorizontalAlignment="Left"
                        Click="OnShowDeleteConfirmationClicked"
                        AutomationProperties.AutomationId="ShowDeleteConfirmation" />
                <StackPanel x:Name="DeleteConfirmation"
                            IsVisible="False"
                            Spacing="10"
                            AutomationProperties.AutomationId="DeleteConfirmation">
                    <TextBlock Text="{loc:Localize Settings_Delete_Confirm}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ConfirmDeleteButton"
                                Content="{loc:Localize Settings_Delete_ConfirmAction}"
                                Classes="danger"
                                Click="OnConfirmDeleteClicked"
                                AutomationProperties.AutomationId="ConfirmDeleteProfile" />
                        <Button x:Name="CancelDeleteButton"
                                Content="{loc:Localize Common_Cancel}"
                                Classes="quiet"
                                Click="OnCancelDeleteClicked"
                                AutomationProperties.AutomationId="CancelDeleteProfile" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </controls:PaperCard>
    </StackPanel>
</UserControl>
