<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Linguistics.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="720"
             d:DesignHeight="900"
             x:Class="Linguistics.App.Features.Settings.SettingsView">
    <StackPanel Spacing="24">
        <controls:PaperCard Classes="settings-sheet">
            <StackPanel Spacing="12">
            <TextBlock Text="Multilingual shortcuts"
                       FontSize="22"
                       FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="2" />
            <TextBlock Text="Choose whether reviewed language comparisons may appear. Every switch remains visible and attributable."
                       TextWrapping="Wrap"
                       Opacity="0.78" />
            <RadioButton x:Name="ShortcutAutomatic"
                         Content="Automatic. Show a reviewed comparison when it is useful"
                         GroupName="SettingsShortcutMode"
                         IsCheckedChanged="OnShortcutChoiceChanged" />
            <RadioButton x:Name="ShortcutAskFirst"
                         Content="Ask first. Let me approve each language switch"
                         GroupName="SettingsShortcutMode"
                         IsCheckedChanged="OnShortcutChoiceChanged" />
            <RadioButton x:Name="ShortcutPreferred"
                         Content="Use one preferred explanation language"
                         GroupName="SettingsShortcutMode"
                         IsCheckedChanged="OnShortcutChoiceChanged" />
            <RadioButton x:Name="ShortcutNever"
                         Content="Never. Keep explanations in the target language experience"
                         GroupName="SettingsShortcutMode"
                         IsCheckedChanged="OnShortcutChoiceChanged" />
            <StackPanel x:Name="PreferredLanguagePanel"
                        Margin="24,4,0,0"
                        Spacing="8"
                        IsVisible="False">
                <TextBlock Text="Preferred explanation language" />
                <ComboBox x:Name="PreferredLanguage"
                          AutomationProperties.Name="Preferred explanation language"
                          AutomationProperties.AutomationId="SettingsPreferredLanguage">
                    <ComboBoxItem x:Name="PreferredEnglish" Content="English" Tag="en" />
                    <ComboBoxItem x:Name="PreferredHindi" Content="Hindi" Tag="hi" />
                </ComboBox>
            </StackPanel>
            </StackPanel>
        </controls:PaperCard>

        <controls:PaperCard Classes="settings-sheet soft">
            <StackPanel Spacing="12">
            <TextBlock Text="Local conversation model"
                       FontSize="22"
                       FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="2" />
            <TextBlock Text="Ollama is optional. Linguistics checks only the loopback service, blocks cloud aliases, and never downloads a model. Scripted practice remains complete without it."
                       TextWrapping="Wrap"
                       Opacity="0.78" />
            <Button x:Name="CheckOllamaButton"
                    Content="Check local Ollama"
                    Classes="quiet"
                    HorizontalAlignment="Left"
                    Click="OnCheckOllamaClicked"
                    AutomationProperties.AutomationId="CheckLocalOllama" />
            <TextBlock x:Name="ModelServiceStatus"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.AutomationId="LocalModelServiceStatus" />
            <TextBlock Text="Conversation model" />
            <ComboBox x:Name="ModelSelection"
                      MinWidth="360"
                      SelectionChanged="OnModelSelectionChanged"
                      AutomationProperties.Name="Local conversation model"
                      AutomationProperties.AutomationId="LocalModelSelection" />
            <TextBlock x:Name="ModelDetailsText"
                       TextWrapping="Wrap"
                       Opacity="0.76"
                       AutomationProperties.AutomationId="LocalModelDetails" />
            <TextBlock Text="Selecting a model is not a compatibility or license recommendation. Model suitability, performance, and redistribution remain unverified until tested and reviewed."
                       TextWrapping="Wrap"
                       Opacity="0.72" />
            </StackPanel>
        </controls:PaperCard>

        <controls:PaperCard Classes="settings-sheet">
            <StackPanel Spacing="12">
            <TextBlock Text="Local speech"
                       FontSize="22"
                       FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="2" />
            <TextBlock Text="Playback uses installed system voices. Microphone transcription uses an explicitly configured local whisper.cpp process and model. Neither is required for text practice."
                       TextWrapping="Wrap"
                       Opacity="0.78" />
            <Button x:Name="CheckSpeechButton"
                    Content="Check local speech"
                    Classes="quiet"
                    HorizontalAlignment="Left"
                    Click="OnCheckSpeechClicked"
                    AutomationProperties.AutomationId="CheckLocalSpeech" />
            <TextBlock x:Name="SpeechServiceStatus"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.AutomationId="LocalSpeechStatus" />
            <TextBlock x:Name="SpeechModelDetailsText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Opacity="0.72"
                       AutomationProperties.AutomationId="LocalSpeechModelDetails" />
            </StackPanel>
        </controls:PaperCard>

        <controls:PaperCard Classes="settings-sheet soft">
            <StackPanel Spacing="12">
            <TextBlock Text="Microphone"
                       FontSize="22"
                       FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="2" />
            <RadioButton x:Name="MicrophoneNow"
                         Content="Use the microphone for local speech practice"
                         GroupName="SettingsMicrophonePreference" />
            <RadioButton x:Name="MicrophoneLater"
                         Content="Decide later"
                         GroupName="SettingsMicrophonePreference" />
            <RadioButton x:Name="MicrophoneNever"
                         Content="Never use the microphone"
                         GroupName="SettingsMicrophonePreference" />
            <TextBlock Text="Changing this preference does not request system permission. Permission is requested only after you choose a speech action and confirm its local processing disclosure."
                       TextWrapping="Wrap"
                       Opacity="0.72" />
            </StackPanel>
        </controls:PaperCard>

        <controls:PaperCard Classes="settings-sheet">
            <StackPanel Spacing="12">
            <TextBlock Text="Legacy audio cleanup"
                       FontSize="22"
                       FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="2" />
            <TextBlock Text="New microphone audio is never retained. Remove any legacy or interrupted audio files here."
                       TextWrapping="Wrap"
                       Opacity="0.72" />
            <Button x:Name="DeleteSpeechRecordingsButton"
                    Content="Delete legacy audio files"
                    Classes="quiet"
                    HorizontalAlignment="Left"
                    Click="OnDeleteSpeechRecordingsClicked"
                    AutomationProperties.AutomationId="DeleteSpeechRecordings" />
            <TextBlock x:Name="SpeechDeletionStatusText"
                       IsVisible="False"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Assertive"
                       AutomationProperties.AutomationId="SpeechDeletionStatus" />
            </StackPanel>
        </controls:PaperCard>

        <controls:PaperCard Classes="settings-sheet soft">
            <StackPanel Spacing="12">
            <TextBlock Text="Motion and focus"
                       FontSize="22"
                       FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="2" />
            <CheckBox x:Name="ReduceMotion"
                      Content="Reduce interface motion"
                      AutomationProperties.AutomationId="SettingsReduceMotion" />
            <TextBlock Text="Removes page fades, lifts, and animated state changes. Color, focus, text, and live status cues remain available. Set LINGUISTICS_REDUCED_MOTION=1 to reduce motion before a profile exists."
                       TextWrapping="Wrap"
                       Opacity="0.72" />
            </StackPanel>
        </controls:PaperCard>

        <TextBlock x:Name="ErrorText"
                   IsVisible="False"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AppDangerBrush}"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.AutomationId="SettingsError" />
        <TextBlock x:Name="StatusText"
                   IsVisible="False"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.AutomationId="SettingsStatus" />
        <Button x:Name="SaveButton"
                Content="Save settings"
                Classes="primary lift"
                HorizontalAlignment="Left"
                Click="OnSaveClicked"
                AutomationProperties.AutomationId="SaveSettings" />

        <controls:PaperCard Classes="danger">
            <StackPanel Spacing="12">
                <TextBlock Text="Delete local learning data"
                           FontSize="20"
                           FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="2" />
                <TextBlock Text="Linguistics stores your profile and learning history locally, with recovery copies owned by the app, a redacted diagnostic log, and any app owned legacy audio files. Deletion removes all of those learner data classes from this device. It preserves unrelated files, installed models, and content packs."
                           TextWrapping="Wrap" />
                <Button x:Name="ShowDeleteConfirmationButton"
                        Content="Delete all learning data"
                        Classes="danger"
                        HorizontalAlignment="Left"
                        Click="OnShowDeleteConfirmationClicked"
                        AutomationProperties.AutomationId="ShowDeleteConfirmation" />
                <StackPanel x:Name="DeleteConfirmation"
                            IsVisible="False"
                            Spacing="10"
                            AutomationProperties.AutomationId="DeleteConfirmation">
                    <TextBlock Text="Delete all local learner history, recovery copies, diagnostics, and legacy audio files now? This cannot be undone. Linguistics will return to setup."
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ConfirmDeleteButton"
                                Content="Delete profile now"
                                Classes="danger"
                                Click="OnConfirmDeleteClicked"
                                AutomationProperties.AutomationId="ConfirmDeleteProfile" />
                        <Button x:Name="CancelDeleteButton"
                                Content="Cancel"
                                Classes="quiet"
                                Click="OnCancelDeleteClicked"
                                AutomationProperties.AutomationId="CancelDeleteProfile" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </controls:PaperCard>
    </StackPanel>
</UserControl>
