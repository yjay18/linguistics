<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Linguistics.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="920"
             x:Class="Linguistics.App.Features.Scenarios.CafeOrderView">
    <StackPanel Spacing="18">
        <StackPanel x:Name="LoadingPanel"
                    Spacing="10">
            <ProgressBar IsIndeterminate="True"
                         AutomationProperties.Name="{loc:Localize Scenario_LoadingName}" />
            <TextBlock Text="{loc:Localize Scenario_Loading}"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <Border x:Name="ContentGatePanel"
                IsVisible="False"
                Classes="warning-card"
                AutomationProperties.AutomationId="CafeContentGate">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Localize Scenario_Gate_Title}"
                           FontSize="21"
                           FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="2" />
                <TextBlock Text="{loc:Localize Scenario_Gate_Body}"
                           TextWrapping="Wrap"
                           LineHeight="22" />
                <TextBlock x:Name="ContentGateTechnicalText"
                           IsVisible="False"
                           TextWrapping="Wrap"
                           Opacity="0.68"
                           AutomationProperties.AutomationId="CafeContentGateTechnical" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="ScenarioPanel"
                    IsVisible="False"
                    Spacing="18">
            <Border Classes="hero-card">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Localize Scenario_Eyebrow}"
                               Classes="eyebrow" />
                    <TextBlock x:Name="GoalText"
                               FontSize="25"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               AutomationProperties.HeadingLevel="2"
                               AutomationProperties.AutomationId="CafeGoal" />
                    <TextBlock x:Name="ContextText"
                               TextWrapping="Wrap"
                               LineHeight="22" />
                    <TextBlock Text="{loc:Localize Scenario_SuccessLooksLike}"
                               Margin="0,5,0,0"
                               FontWeight="SemiBold" />
                    <ItemsControl x:Name="SuccessCriteriaList"
                                  AutomationProperties.AutomationId="CafeSuccessCriteria" />
                </StackPanel>
            </Border>

            <ContentControl x:Name="BridgeHost"
                            IsVisible="False"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="CafeBridgeHost" />

            <Border x:Name="ReadyPanel"
                    Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="ReadyStatusText"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.AutomationId="CafeReadyStatus" />
                    <TextBlock x:Name="MissingPrerequisitesText"
                               IsVisible="False"
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                    <TextBlock x:Name="PreviousAttemptsText"
                               FontSize="13"
                               Opacity="0.72" />
                    <Button x:Name="StartButton"
                            Content="{loc:Localize Today_EnterCafe}"
                            Classes="primary lift"
                            HorizontalAlignment="Left"
                            Click="OnStartClicked"
                            AutomationProperties.AutomationId="StartCafeScenario" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="ActiveScenarioPanel"
                        IsVisible="False"
                        Spacing="16">
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{loc:Localize Scenario_AtCounter}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="2" />
                        <StackPanel x:Name="ConversationPanel"
                                    Spacing="10"
                                    AutomationProperties.AutomationId="CafeConversation" />
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <Button Content="{loc:Localize Scenario_Translation}"
                                    Classes="quiet"
                                    Click="OnTranslationClicked"
                                    AutomationProperties.AutomationId="CafeTranslation" />
                            <Button Content="{loc:Localize Scenario_Hint}"
                                    Classes="quiet"
                                    Click="OnHintClicked"
                                    AutomationProperties.AutomationId="CafeHint" />
                            <Button x:Name="RepeatButton"
                                    Content="{loc:Localize Scenario_PlayCaption}"
                                    Classes="quiet"
                                    Click="OnRepeatClicked"
                                    AutomationProperties.AutomationId="CafeRepeat" />
                            <Button x:Name="SlowerButton"
                                    Content="{loc:Localize Scenario_Slower}"
                                    Classes="quiet"
                                    Click="OnSlowerClicked"
                                    AutomationProperties.AutomationId="CafeRepeatSlower" />
                            <Button x:Name="StopPlaybackButton"
                                    Content="{loc:Localize Scenario_Stop}"
                                    Classes="quiet"
                                    Click="OnStopPlaybackClicked"
                                    AutomationProperties.AutomationId="CafeStopPlayback" />
                        </StackPanel>
                        <TextBlock x:Name="SupportText"
                                   IsVisible="False"
                                   TextWrapping="Wrap"
                                   Opacity="0.78"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.AutomationId="CafeSupportText" />
                    </StackPanel>
                </Border>

                <Border x:Name="FeedbackPanel"
                        IsVisible="False"
                        Classes="accent-card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Localize Scenario_Adjustment}"
                                   FontSize="13"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="FeedbackMessageText"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive"
                                   AutomationProperties.AutomationId="CafePrimaryFeedback" />
                        <TextBlock x:Name="RetryPromptText"
                                   TextWrapping="Wrap" />
                        <Expander x:Name="OtherObservationsExpander"
                                  IsVisible="False"
                                  Header="{loc:Localize Scenario_OtherObservations}">
                            <TextBlock x:Name="OtherObservationsText"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />
                        </Expander>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="InputPanel"
                            Spacing="10">
                    <TextBlock Text="{loc:Localize Scenario_YourReply}" FontWeight="SemiBold" />
                    <TextBox x:Name="LearnerInput"
                             PlaceholderText="{loc:Localize Scenario_InputPlaceholder}"
                             MaxLength="500"
                             KeyDown="OnLearnerInputKeyDown"
                             TextChanged="OnLearnerInputChanged"
                             AutomationProperties.AutomationId="CafeLearnerInput" />
                    <TextBlock x:Name="SpeechStatusText"
                               TextWrapping="Wrap"
                               Opacity="0.72"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.AutomationId="CafeSpeechStatus" />
                    <Button x:Name="RecordReplyButton"
                            Content="{loc:Localize Scenario_RecordReply}"
                            Classes="quiet"
                            HorizontalAlignment="Left"
                            Click="OnRecordClicked"
                            AutomationProperties.AutomationId="CafeRecordReply" />
                    <Border x:Name="SpeechDisclosurePanel"
                            IsVisible="False"
                            Classes="warning-card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:Localize Scenario_MicrophoneDisclosure_Title}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Localize Scenario_MicrophoneDisclosure_Body}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Button x:Name="ConfirmRecordButton"
                                        Content="{loc:Localize Scenario_StartRecording}"
                                        Classes="primary lift"
                                        Click="OnConfirmRecordClicked"
                                        AutomationProperties.AutomationId="CafeConfirmRecord" />
                                <Button Content="{loc:Localize Scenario_NotNow}"
                                        Classes="quiet"
                                        Click="OnDismissRecordClicked"
                                        AutomationProperties.AutomationId="CafeDismissRecord" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="RecordingPanel"
                                IsVisible="False"
                                Spacing="9">
                        <ProgressBar IsIndeterminate="True"
                                     AutomationProperties.Name="{loc:Localize Scenario_RecordingName}" />
                        <TextBlock Text="{loc:Localize Scenario_RecordingBody}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <Button Content="{loc:Localize Scenario_CancelRecording}"
                                HorizontalAlignment="Left"
                                Click="OnCancelRecordingClicked"
                                AutomationProperties.AutomationId="CafeCancelRecording" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Button x:Name="SendButton"
                                Content="{loc:Localize Scenario_SendReply}"
                                Classes="primary lift"
                                Click="OnSendClicked"
                                AutomationProperties.AutomationId="SendCafeReply" />
                        <Button x:Name="CancelResponseButton"
                                Content="{loc:Localize Scenario_CancelResponse}"
                                IsVisible="False"
                                Click="OnCancelResponseClicked"
                                AutomationProperties.AutomationId="CancelCafeResponse" />
                        <Button x:Name="ExitButton"
                                Content="{loc:Localize Scenario_Exit}"
                                Classes="quiet"
                                Click="OnExitClicked"
                                AutomationProperties.AutomationId="ExitCafeScenario" />
                    </StackPanel>
                    <TextBlock x:Name="TurnStatusText"
                               TextWrapping="Wrap"
                               Opacity="0.72"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.AutomationId="CafeTurnStatus" />
                </StackPanel>

                <Border x:Name="CompletionPanel"
                        IsVisible="False"
                        Classes="hero-card"
                        AutomationProperties.AutomationId="CafeCompletion">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Localize Scenario_Completed_Title}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="2" />
                        <TextBlock Text="{loc:Localize Scenario_Completed_Body}"
                                   TextWrapping="Wrap"
                                   LineHeight="22" />
                        <TextBlock x:Name="EvidenceText"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="CafeEvidence" />
                        <TextBlock x:Name="PersistenceStatusText"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive"
                                   AutomationProperties.AutomationId="CafePersistenceStatus" />
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Button x:Name="RetrySaveButton"
                                    Content="{loc:Localize Scenario_RetrySave}"
                                    IsVisible="False"
                                    Click="OnRetrySaveClicked"
                                    AutomationProperties.AutomationId="RetryCafeSave" />
                            <Button x:Name="PracticeAgainButton"
                                    Content="{loc:Localize Scenario_PracticeAgain}"
                                    Classes="primary lift"
                                    IsVisible="False"
                                    Click="OnPracticeAgainClicked"
                                    AutomationProperties.AutomationId="PracticeCafeAgain" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Expander x:Name="DeveloperPanel"
                          IsVisible="False"
                          Header="Developer trace">
                    <TextBlock x:Name="DeveloperTraceText"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               FontFamily="monospace"
                               FontSize="12"
                               AutomationProperties.AutomationId="CafeDeveloperTrace" />
                </Expander>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
