<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Linguistics.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="720"
        x:Class="Linguistics.App.MainWindow"
        Title="Linguistics"
        Width="1220"
        Height="800"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource AppCanvasBrush}">
        <Canvas IsHitTestVisible="False"
                ClipToBounds="True">
            <Ellipse Width="520"
                     Height="520"
                     Canvas.Left="-210"
                     Canvas.Top="-250"
                     Fill="{DynamicResource AppAccentSoftBrush}"
                     Opacity="0.5" />
            <Ellipse Width="440"
                     Height="440"
                     Canvas.Right="-180"
                     Canvas.Bottom="-240"
                     Fill="{DynamicResource AppAmberSoftBrush}"
                     Opacity="0.42" />
        </Canvas>
        <ContentControl x:Name="RootContent"
                        AutomationProperties.AutomationId="RootContent" />

        <Border x:Name="StartupStatus"
                Background="Transparent"
                AutomationProperties.LandmarkType="Main">
            <Border Width="500"
                    Classes="card"
                    Padding="38"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="15">
                    <Border Width="58"
                            Height="58"
                            CornerRadius="19"
                            Background="{DynamicResource AppGlowBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="L"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppNavBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{loc:Localize Startup_Eyebrow}"
                               Classes="eyebrow"
                               TextAlignment="Center" />
                    <TextBlock x:Name="StartupTitle"
                               Text="{loc:Localize Startup_OpeningTitle}"
                               FontSize="30"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               AutomationProperties.HeadingLevel="1" />
                    <TextBlock x:Name="StartupMessage"
                               Text="{loc:Localize Startup_LoadingProfile}"
                               Classes="muted"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               LineHeight="23"
                               AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar x:Name="StartupProgress"
                                 Margin="0,5,0,0"
                                 IsIndeterminate="True"
                                 AutomationProperties.Name="{loc:Localize Startup_OpeningTitle}" />
                    <Button x:Name="RetryButton"
                            Classes="primary lift"
                            Content="{loc:Localize Common_TryAgain}"
                            HorizontalAlignment="Center"
                            IsVisible="False"
                            Click="OnRetryClicked"
                            AutomationProperties.AutomationId="RetryStartup" />
                    <Button x:Name="RecoveryButton"
                            Classes="quiet"
                            Content="{loc:Localize Startup_PreserveAndRestart}"
                            HorizontalAlignment="Center"
                            IsVisible="False"
                            Click="OnRecoveryClicked"
                            AutomationProperties.AutomationId="RecoverLearnerStore" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
